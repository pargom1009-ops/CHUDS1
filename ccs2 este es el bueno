  .pestana { font-size: .53rem; }
  .pestana__icono { font-size: 1.12rem; }
}
@media (prefers-reduced-motion: reduce) {
  #btn-generar-header.aura-activa, #btn-generar-header.aura-activa::after { animation-duration: .01ms !important; }
}


/* Panel de presupuesto: el tamaño lo interpola el scroll, sin saltos por clases. */

/* Cada página tiene un matiz propio y un pequeño motivo decorativo. */
.slider-vistas > .seccion-vista {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  border-color: transparent;
}
.slider-vistas > .seccion-vista > * { position: relative; z-index: 1; }
.slider-vistas > .seccion-vista::before {
  position: absolute;
  z-index: 0;
  right: 14px;
  bottom: 8px;
  color: var(--doodle-color, #587b63);
  content: var(--doodle, "✧");
  font-family: Georgia, serif;
  font-size: clamp(4rem, 15vw, 7rem);
  line-height: 1;
  opacity: .12;
  transform: rotate(-12deg);
  pointer-events: none;
}
.slider-vistas > .seccion-vista::after {
  position: absolute;
  z-index: 0;
  top: -62px;
  right: -46px;
  width: 180px;
  height: 180px;
  border: 1px solid var(--doodle-color, #587b63);
  border-radius: 50%;
  content: "";
  opacity: .12;
  box-shadow: 0 0 0 18px rgb(255 255 255 / 18%), 0 0 0 38px rgb(255 255 255 / 14%);
  pointer-events: none;
}
#seccion-familia { --doodle: "✿"; --doodle-color: #3c8b62; background: linear-gradient(145deg, #fffefa, #f1faf4 80%); }
#seccion-menu { --doodle: "✳"; --doodle-color: #8370bd; background: linear-gradient(145deg, #fff, #f4f1ff 88%); }
#seccion-compras { --doodle: "⌁"; --doodle-color: #d27b57; background: linear-gradient(145deg, #fffefa, #fff2e9 88%); }
#seccion-despensa { --doodle: "❋"; --doodle-color: #69964c; background: linear-gradient(145deg, #fff, #f1f7e9 88%); }
#seccion-favoritos { --doodle: "♡"; --doodle-color: #cb6f8b; background: linear-gradient(145deg, #fff, #fff0f4 88%); }
#seccion-asistente { --doodle: "✦"; --doodle-color: #6584bb; background: linear-gradient(145deg, #fff, #eff5ff 88%); }

@media (max-width: 640px) {
  .slider-vistas > .seccion-vista::before { right: 8px; bottom: 8px; font-size: 4.7rem; }
  .slider-vistas > .seccion-vista::after { top: -74px; right: -62px; width: 150px; height: 150px; }
}


/* Compactación del resumen ligada al desplazamiento: el progreso sigue el scroll. */
@supports (animation-timeline: scroll()) {
  .panel-resumen {
    animation: compactar-presupuesto linear both;
    animation-timeline: scroll(root);
    animation-range: 10px 260px;
  }
  .panel-resumen__metricas {
    animation: compactar-metricas linear both;
    animation-timeline: scroll(root);
    animation-range: 10px 260px;
  }
  .panel-resumen .alerta-presupuesto {
    animation: ocultar-aviso-presupuesto linear both;
    animation-timeline: scroll(root);
    animation-range: 10px 230px;
  }
  @keyframes compactar-presupuesto {
    from { padding: 22px 24px; border-radius: 26px; }
    to { padding: 8px 15px; border-radius: 17px; }
  }
  @keyframes compactar-metricas {
    from { gap: 18px; margin-bottom: 14px; }
    to { gap: 8px; margin-bottom: 5px; }
  }
  @keyframes ocultar-aviso-presupuesto {
    from { max-height: 72px; opacity: 1; padding: 10px 14px; margin: 8px 0 0; }
    to { max-height: 0; opacity: 0; padding: 0; margin: 0; }
  }
}
.panel-resumen.resumen-fallback-compacto {
  padding: 8px 15px;
  border-radius: 17px;
}
.panel-resumen.resumen-fallback-compacto .panel-resumen__metricas {
  gap: 8px;
  margin-bottom: 5px;
}
.panel-resumen.resumen-fallback-compacto .alerta-presupuesto {
  max-height: 0;
  margin: 0;
  padding: 0;
  overflow: hidden;
  opacity: 0;
}

/* Entrada delicada para cada sección cuando se toca el dock o se desliza. */
.slider-vistas > .seccion-vista { animation: none; }
.slider-vistas > .seccion-vista.vista-animando {
  animation: entrada-seccion 220ms ease-out both;
  backface-visibility: hidden;
}
@keyframes entrada-seccion {
  from { opacity: .8; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Palomita que aparece sobre el ingrediente, sube y se desvanece. */
.animacion-paloma {
  position: fixed;
  z-index: 120;
  display: grid;
  width: 30px;
  height: 30px;
  place-items: center;
  border: 1px solid rgb(33 124 73 / 18%);
  border-radius: 50%;
  background: #e3f6e8;
  color: #197442;
  box-shadow: 0 5px 16px rgb(33 124 73 / 18%);
  font-size: 1rem;
  font-weight: 800;
  pointer-events: none;
  animation: paloma-asciende 540ms ease-out forwards;
}
@keyframes paloma-asciende {
  0% { opacity: 0; transform: translateY(5px) scale(.9); }
  20% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-30px); }
}

/* Botón de configuración y diálogo pequeño, dedicado solo al tema oscuro. */
.boton-configuracion, .boton-configuracion__cerrar {
  display: grid;
  flex: 0 0 auto;
  width: 40px;
  height: 40px;
  place-items: center;
  border: 1px solid var(--color-borde);
  border-radius: 50%;
  background: var(--color-superficie);
  color: var(--color-texto-secundario);
  font-size: 1.1rem;
  cursor: pointer;
  transition: transform 180ms ease, background 180ms ease, color 180ms ease;
}
.boton-configuracion:hover { transform: rotate(24deg); color: var(--color-primario); }
.config-dialog {
  width: min(360px, calc(100% - 28px));
  max-width: none;
  padding: 0;
  overflow: visible;
  border: 0;
  border-radius: 22px;
  background: transparent;
  color: var(--color-texto);
}
.config-dialog::backdrop { background: rgb(15 24 18 / 32%); backdrop-filter: blur(4px); }
.config-dialog__panel {
  padding: 20px;
  border: 1px solid var(--color-borde);
  border-radius: 22px;
  background: var(--color-superficie);
  box-shadow: 0 24px 70px rgb(0 0 0 / 18%);
}
.config-dialog__cabecera { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
.config-dialog__cabecera h2 { font-size: 1.1rem; }
.boton-configuracion__cerrar { width: 32px; height: 32px; font-size: 1.35rem; }
.modo-oscuro-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 14px;
  border: 1px solid var(--color-borde);
  border-radius: 16px;
  background: var(--color-superficie-alt);
}
.modo-oscuro-control > span { display: grid; gap: 3px; }
.modo-oscuro-control small { color: var(--color-texto-suave); }
.modo-oscuro-control input[role="switch"] {
  appearance: none;
  position: relative;
  flex: 0 0 auto;
  width: 46px;
  height: 27px;
  margin: 0;
  border: 0;
  border-radius: 999px;
  background: #cbd2cc;
  cursor: pointer;
  transition: background 180ms ease;
}
.modo-oscuro-control input[role="switch"]::before {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 21px;
  height: 21px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 1px 4px rgb(0 0 0 / 20%);
  content: "";
  transition: transform 180ms ease;
}
.modo-oscuro-control input[role="switch"]:checked { background: var(--color-primario); }
.modo-oscuro-control input[role="switch"]:checked::before { transform: translateX(19px); }

/* Tema oscuro con versiones profundas de las seis paletas de sección. */
body.modo-oscuro {
  color-scheme: dark;
  --color-fondo: #101713;
  --color-superficie: #1b241e;
  --color-superficie-alt: #252f28;
  --color-borde: #354238;
  --color-borde-fuerte: #4a5d4e;
  --color-texto: #eef4ef;
  --color-texto-secundario: #c3d0c6;
  --color-texto-suave: #9caea0;
  --color-primario: #70c391;
  --color-primario-hover: #8ad5a7;
  --color-primario-suave: #253d30;
  background: radial-gradient(ellipse at 90% 0%, #1d3024, transparent 28rem), #101713;
}
body.modo-oscuro .barra-superior { background: rgb(20 28 23 / 86%); }
body.modo-oscuro .pestanas { border-color: #354238; background: rgb(27 36 30 / 92%); }
body.modo-oscuro .panel-resumen,
body.modo-oscuro .preferencias-panel,
body.modo-oscuro .preferencias-extra,
body.modo-oscuro .tarjeta-dia,
body.modo-oscuro .tarjeta-tienda,
body.modo-oscuro .tarjeta-favorito,
body.modo-oscuro .panel-despensa,
body.modo-oscuro .panel-recetas-despensa,
body.modo-oscuro .modal__contenido { background-color: var(--color-superficie); color: var(--color-texto); }
body.modo-oscuro .panel-resumen { background-image: linear-gradient(145deg, #1b241e, #1b2a20); }
body.modo-oscuro #seccion-familia { background: linear-gradient(145deg, #1b241e, #1a2c22 88%); }
body.modo-oscuro #seccion-menu { background: linear-gradient(145deg, #1b241e, #252239 88%); }
body.modo-oscuro #seccion-compras { background: linear-gradient(145deg, #1b241e, #38271f 88%); }
body.modo-oscuro #seccion-despensa { background: linear-gradient(145deg, #1b241e, #25301f 88%); }
body.modo-oscuro #seccion-favoritos { background: linear-gradient(145deg, #1b241e, #35242c 88%); }
body.modo-oscuro #seccion-asistente { background: linear-gradient(145deg, #1b241e, #202d3c 88%); }
body.modo-oscuro input:not([type="checkbox"]),
body.modo-oscuro select,
body.modo-oscuro textarea { border-color: var(--color-borde); background: #18211b; color: var(--color-texto); }
body.modo-oscuro .check-caja,
body.modo-oscuro .tabla-nutrimental th,
body.modo-oscuro .tabla-nutrimental td { color: var(--color-texto); }
body.modo-oscuro .tabla-nutrimental caption { background: var(--color-superficie-alt); color: var(--color-texto-secundario); }
body.modo-oscuro .tabla-nutrimental-contenedor { border-color: var(--color-borde); }
body.modo-oscuro .config-dialog__panel { background: var(--color-superficie); }
body.modo-oscuro .boton-configuracion { background: var(--color-superficie); color: var(--color-texto); }
body.modo-oscuro .objetivo-opcion { background: #202a23; color: var(--color-texto); }
body.modo-oscuro .objetivo-opcion[aria-pressed="true"] { background: var(--color-primario-suave); }
body.modo-oscuro .estado-vacio { color: var(--color-texto-suave); }

@media (max-width: 640px) {
  .barra-superior__interior { gap: 8px; }
