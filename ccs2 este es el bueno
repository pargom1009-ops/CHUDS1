/* Selector de personas en burbujas */
.personas-burbujas {
  display: grid;
  grid-template-columns: repeat(5, minmax(38px, 1fr));
  gap: 8px;
  max-width: 360px;
  padding: 4px 1px;
}
.burbuja-personas {
  display: grid;
  width: 42px;
  height: 42px;
  place-items: center;
  justify-self: center;
  border: 1px solid var(--color-borde);
  border-radius: 50%;
  background: var(--color-superficie);
  color: var(--color-texto-secundario);
  font-weight: 700;
  cursor: pointer;
  transition: transform 180ms ease, background 180ms ease, color 180ms ease, box-shadow 180ms ease;
}
.burbuja-personas:hover { transform: translateY(-2px); }
.burbuja-personas.activa {
  transform: scale(1.06);
  border-color: var(--color-primario);
  background: var(--color-primario);
  color: #fff;
  box-shadow: 0 5px 14px rgb(27 107 74 / 22%);
}
.personas-ilustracion {
  display: flex;
  min-height: 58px;
  align-items: center;
  gap: 10px;
  margin-top: 6px;
  padding: 8px 12px;
  border-radius: 16px;
  background: var(--color-superficie-alt);
  color: var(--color-texto-secundario);
  font-size: .86rem;
  font-weight: 600;
}
.personas-ilustracion__figuras { display: flex; align-items: center; padding-left: 3px; }
.persona-figura {
  display: inline-grid;
  width: 30px;
  height: 34px;
  place-items: center;
  margin-left: -4px;
  border: 2px solid var(--color-superficie-alt);
  border-radius: 50%;
  background: var(--color-superficie);
  font-size: 1.22rem;
  animation: persona-aparece 240ms ease both;
}
.persona-figura:nth-child(2) { animation-delay: 35ms; }
.persona-figura:nth-child(3) { animation-delay: 70ms; }
.persona-figura:nth-child(4) { animation-delay: 105ms; }
.persona-figura:nth-child(5) { animation-delay: 140ms; }
@keyframes persona-aparece { from { opacity: 0; transform: scale(.65) translateY(5px); } to { opacity: 1; transform: scale(1) translateY(0); } }

/* Selector de idioma dentro de Configuración */
