/* El botón de planear emite un halo que se expande al tocarlo. */
#btn-generar-header { position: relative; isolation: isolate; overflow: visible; }
#btn-generar-header.aura-activa { animation: pulso-planear 520ms ease-out; }
#btn-generar-header.aura-activa::after {
  content: "";
  position: absolute;
  z-index: -1;
  inset: -4px;
  border: 2px solid color-mix(in srgb, var(--color-primario) 52%, white);
  border-radius: inherit;
  pointer-events: none;
  animation: aura-expansiva 520ms ease-out both;
}
@keyframes aura-expansiva {
  0% { opacity: .55; transform: scale(.98); }
  100% { opacity: 0; transform: scale(1.22); }
}
@keyframes pulso-planear {
  0%, 100% { transform: translateY(0) scale(1); }
  35% { transform: translateY(-1px) scale(1.02); }
}
@media (min-width: 720px) {
  .preferencias-panel__grid { grid-template-columns: 1fr 1fr; gap: 24px; }
  .preferencias-subgrupo + .preferencias-subgrupo { padding-top: 0; padding-left: 22px; border-top: 0; border-left: 1px solid var(--color-borde); }
}
@media (max-width: 640px) {
  .preferencias-panel { padding: 17px 15px; }
