/* ==========================================================================
   Planeador de Comida y Despensa — Estilos puros en CSS
   Sistema de diseño limpio, responsivo y con variables para colores.
   ========================================================================== */

:root {
  /* Paleta neutra (60% fondo, 30% superficies y bordes) */
  --color-fondo: #f7f8f7;
  --color-superficie: #ffffff;
  --color-superficie-alt: #f1f4f2;
  --color-borde: #dfe5e1;
  --color-borde-fuerte: #c5d0c9;

  /* Tipografía */
  --color-texto: #142019;
  --color-texto-secundario: #4b5c52;
  --color-texto-suave: #66786d;

  /* Acento principal (10% del presupuesto visual) */
  --color-primario: #1b6b4a;
  --color-primario-hover: #145339;
  --color-primario-suave: #ebf6f0;

  /* Colores semánticos (siempre acompañados de texto explícito) */
  --color-exito: #157347;
  --color-exito-fondo: #edf8f2;
  --color-aviso: #a15c07;
  --color-aviso-fondo: #fef7eb;
  --color-peligro: #b42318;
  --color-peligro-fondo: #fef2f2;

  /* Fuentes */
  --fuente-titulos: "Plus Jakarta Sans", system-ui, -apple-system, sans-serif;
  --fuente-cuerpo: "DM Sans", system-ui, -apple-system, sans-serif;

  /* Radios y espaciado */
  --radio-chico: 6px;
  --radio-medio: 10px;
  --radio-grande: 14px;
  --transicion: 160ms cubic-bezier(0.16, 1, 0.3, 1);
}

/* Reinicio básico */
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: var(--fuente-cuerpo);
  font-size: 15px;
  line-height: 1.55;
  color: var(--color-texto);
  background-color: var(--color-fondo);
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3, h4 {
  margin: 0;
  font-family: var(--fuente-titulos);
  font-weight: 700;
  line-height: 1.25;
  color: var(--color-texto);
  text-wrap: balance;
}

p {
  margin: 0;
}

button,
input,
select {
  font-family: inherit;
  font-size: inherit;
}

:focus-visible {
  outline: 2px solid var(--color-primario);
  outline-offset: 2px;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.oculto {
  display: none !important;
}

.numero {
  font-variant-numeric: tabular-nums;
}

/* Contenedor principal */
.contenedor {
  width: 100%;
  max-width: 1180px;
  margin-inline: auto;
  padding-inline: 20px;
}

/* ==========================================================================
   Barra superior (3 zonas en una sola línea)
   ========================================================================== */
.barra-superior {
  position: sticky;
  top: 0;
  z-index: 30;
  background-color: var(--color-superficie);
  border-bottom: 1px solid var(--color-borde);
}

.barra-superior__interior {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  min-height: 64px;
}

.marca {
  font-family: var(--fuente-titulos);
  font-size: 1.05rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--color-texto);
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
}

.navegacion {
  display: flex;
  align-items: center;
  gap: 22px;
}

.navegacion__enlace {
  font-size: 0.92rem;
  font-weight: 500;
  color: var(--color-texto-secundario);
  text-decoration: none;
  padding-block: 6px;
  border-bottom: 2px solid transparent;
  white-space: nowrap;
  flex-shrink: 0;
  transition: color var(--transicion), border-color var(--transicion);
}

.navegacion__enlace:hover,
.navegacion__enlace.activo {
  color: var(--color-texto);
  border-bottom-color: var(--color-primario);
}

/* ==========================================================================
   Botones
   ========================================================================== */
.boton {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 40px;
  padding: 9px 18px;
  border-radius: var(--radio-chico);
  border: 1px solid transparent;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  flex-shrink: 0;
  transition: background-color var(--transicion), border-color var(--transicion), color var(--transicion), transform var(--transicion);
}

.boton:active {
  transform: translateY(1px);
}

.boton--primario {
  background-color: var(--color-primario);
  color: #ffffff;
}

.boton--primario:hover {
  background-color: var(--color-primario-hover);
}

.boton--secundario {
  background-color: var(--color-superficie);
  color: var(--color-texto);
  border-color: var(--color-borde-fuerte);
}

.boton--secundario:hover {
  background-color: var(--color-superficie-alt);
}

.boton--texto {
  background-color: transparent;
  color: var(--color-texto-secundario);
  padding-inline: 10px;
}

.boton--texto:hover {
  color: var(--color-texto);
  background-color: var(--color-superficie-alt);
}

.boton--chico {
  min-height: 34px;
  padding: 6px 12px;
  font-size: 0.82rem;
}

/* ==========================================================================
   Contenido principal y Panel de presupuesto
   ========================================================================== */
.contenido-principal {
  padding-block: 24px 56px;
}

.panel-resumen {
  background-color: var(--color-superficie);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-grande);
  padding: 20px 24px;
  margin-bottom: 20px;
}

.panel-resumen__metricas {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 14px;
}

.metrica {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.metrica__etiqueta {
  font-size: 0.8rem;
  color: var(--color-texto-suave);
}

.metrica__valor {
  font-family: var(--fuente-titulos);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--color-texto);
}

.metrica__valor--exito {
  color: var(--color-exito);
}

.metrica__valor--peligro {
  color: var(--color-peligro);
}

.barra-progreso-contenedor {
  width: 100%;
  height: 8px;
  background-color: var(--color-superficie-alt);
  border-radius: 999px;
  overflow: hidden;
  margin-bottom: 12px;
}

.barra-progreso__relleno {
  height: 100%;
  width: 0%;
  background-color: var(--color-primario);
  border-radius: 999px;
  transition: width 260ms ease, background-color 200ms ease;
}

.barra-progreso__relleno--aviso {
  background-color: var(--color-aviso);
}

.barra-progreso__relleno--peligro {
  background-color: var(--color-peligro);
}

.alerta-presupuesto {
  font-size: 0.9rem;
  padding: 10px 14px;
  border-radius: var(--radio-chico);
  background-color: var(--color-superficie-alt);
  color: var(--color-texto-secundario);
}

.alerta-presupuesto--exito {
  background-color: var(--color-exito-fondo);
  color: var(--color-exito);
}

.alerta-presupuesto--aviso {
  background-color: var(--color-aviso-fondo);
  color: var(--color-aviso);
}

.alerta-presupuesto--peligro {
  background-color: var(--color-peligro-fondo);
  color: var(--color-peligro);
  font-weight: 500;
}

/* ==========================================================================
   Pestañas de secciones
   ========================================================================== */
.pestanas {
  display: flex;
  gap: 6px;
  padding: 5px;
  background-color: var(--color-superficie-alt);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-medio);
  margin-bottom: 24px;
  overflow-x: auto;
  scrollbar-width: thin;
}

.pestana {
  flex: 1 0 auto;
  min-height: 40px;
  padding: 8px 14px;
  border: none;
  border-radius: var(--radio-chico);
  background: transparent;
  color: var(--color-texto-secundario);
  font-size: 0.88rem;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: background-color var(--transicion), color var(--transicion);
}

.pestana:hover {
  color: var(--color-texto);
}

.pestana.activa {
  background-color: var(--color-superficie);
  color: var(--color-texto);
  box-shadow: 0 1px 2px rgba(20, 32, 25, 0.08);
}

/* ==========================================================================
   Secciones y encabezados
   ========================================================================== */
.seccion-vista {
  display: none;
}

.seccion-vista.activa {
  display: block;
}

.encabezado-seccion {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 22px;
  flex-wrap: wrap;
}

.titulo-seccion {
  font-size: 1.55rem;
  margin-bottom: 6px;
}

.descripcion-seccion {
  color: var(--color-texto-secundario);
  max-width: 68ch;
  font-size: 0.94rem;
}

.acciones-seccion {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

/* ==========================================================================
   Sección 1: Formulario de familia y presupuesto
   ========================================================================== */
.formulario-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  background-color: var(--color-superficie);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-grande);
  padding: 24px;
}

.bloque-campo {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.bloque-campo--completo {
  grid-column: 1 / -1;
}

.etiqueta-campo {
  font-weight: 600;
  font-size: 0.92rem;
  color: var(--color-texto);
}

.etiqueta-secundaria {
  font-size: 0.84rem;
  color: var(--color-texto-secundario);
  margin-top: 8px;
}

.ayuda-campo {
  font-size: 0.82rem;
  color: var(--color-texto-suave);
}

input[type="text"],
input[type="number"],
select {
  width: 100%;
  min-height: 42px;
  padding: 9px 12px;
  border: 1px solid var(--color-borde-fuerte);
  border-radius: var(--radio-chico);
  background-color: var(--color-superficie);
  color: var(--color-texto);
  transition: border-color var(--transicion);
}

input[type="text"]:focus,
input[type="number"]:focus,
select:focus {
  border-color: var(--color-primario);
  outline: none;
}

.campo-prefijo {
  display: flex;
  align-items: center;
  border: 1px solid var(--color-borde-fuerte);
  border-radius: var(--radio-chico);
  background-color: var(--color-superficie);
  overflow: hidden;
}

.campo-prefijo:focus-within {
  border-color: var(--color-primario);
}

.campo-prefijo input {
  border: none;
  min-height: 40px;
}

.campo-prefijo__simbolo,
.campo-prefijo__sufijo {
  padding-inline: 12px;
  font-size: 0.86rem;
  font-weight: 600;
  color: var(--color-texto-suave);
  background-color: var(--color-superficie-alt);
  align-self: stretch;
  display: flex;
  align-items: center;
}

.opciones-rapidas {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 4px;
}

.boton-opcion {
  min-height: 34px;
  padding: 5px 12px;
  border: 1px solid var(--color-borde-fuerte);
  border-radius: var(--radio-chico);
  background-color: var(--color-superficie);
  color: var(--color-texto-secundario);
  font-size: 0.84rem;
  cursor: pointer;
  transition: background-color var(--transicion), border-color var(--transicion), color var(--transicion);
}

.boton-opcion:hover {
  border-color: var(--color-primario);
  color: var(--color-texto);
}

.boton-opcion.seleccionado {
  background-color: var(--color-primario-suave);
  border-color: var(--color-primario);
  color: var(--color-primario);
  font-weight: 600;
}

.grupo-opciones {
  border: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.rejilla-checks {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
  gap: 10px;
}

.check-caja {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 40px;
  padding: 8px 12px;
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-chico);
  background-color: var(--color-superficie);
  font-size: 0.9rem;
  cursor: pointer;
  transition: border-color var(--transicion), background-color var(--transicion);
}

.check-caja:hover {
  background-color: var(--color-superficie-alt);
}

.check-caja input[type="checkbox"] {
  width: 17px;
  height: 17px;
  accent-color: var(--color-primario);
  cursor: pointer;
}

.agregar-tienda-fila {
  display: flex;
  gap: 10px;
  margin-top: 4px;
}

.acciones-formulario {
  display: flex;
  align-items: center;
  gap: 14px;
  padding-top: 8px;
  border-top: 1px solid var(--color-borde);
  flex-wrap: wrap;
}

/* ==========================================================================
   Sección 2: Menú semanal
   ========================================================================== */
.panel-sustitutos {
  background-color: var(--color-aviso-fondo);
  border: 1px solid #f0d7b1;
  border-radius: var(--radio-medio);
  padding: 16px 20px;
  margin-bottom: 20px;
}

.panel-sustitutos__titulo {
  font-size: 0.96rem;
  color: var(--color-aviso);
  margin-bottom: 10px;
}

.lista-sustitutos {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.item-sustituto {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding-top: 10px;
  border-top: 1px solid rgba(161, 92, 7, 0.16);
  flex-wrap: wrap;
}

.item-sustituto:first-child {
  padding-top: 0;
  border-top: none;
}

.item-sustituto__texto {
  font-size: 0.9rem;
  color: var(--color-texto);
}

.item-sustituto__ahorro {
  font-size: 0.84rem;
  color: var(--color-exito);
  font-weight: 600;
}

.grid-menu {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
  gap: 18px;
}

.tarjeta-dia {
  background-color: var(--color-superficie);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-grande);
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.tarjeta-dia__cabecera {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--color-borde);
}

.tarjeta-dia__nombre {
  font-size: 1.05rem;
}

.tarjeta-dia__total {
  font-size: 0.86rem;
  font-weight: 600;
  color: var(--color-texto-secundario);
}

.comida-bloque {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--color-superficie-alt);
}

.comida-bloque:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.comida-bloque__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.78rem;
  color: var(--color-texto-suave);
}

.comida-bloque__fila {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}

.comida-bloque__titulo {
  font-weight: 600;
  font-size: 0.96rem;
  color: var(--color-texto);
  background: none;
  border: none;
  padding: 0;
  text-align: left;
  cursor: pointer;
}

.comida-bloque__titulo:hover {
  color: var(--color-primario);
  text-decoration: underline;
}

.comida-bloque__acciones {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.boton-icono {
  min-width: 32px;
  min-height: 32px;
  padding: 4px 8px;
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-chico);
  background-color: var(--color-superficie);
  color: var(--color-texto-secundario);
  font-size: 0.8rem;
  cursor: pointer;
  transition: background-color var(--transicion), color var(--transicion), border-color var(--transicion);
}

.boton-icono:hover {
  background-color: var(--color-superficie-alt);
  color: var(--color-texto);
}

.boton-icono.favorito-activo {
  color: #b45309;
  border-color: #eab308;
  background-color: #fefce8;
}

/* ==========================================================================
   Sección 3: Lista de compras por tienda
   ========================================================================== */
.resumen-compras-barra {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  background-color: var(--color-superficie);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-medio);
  padding: 14px 18px;
  margin-bottom: 20px;
  font-size: 0.9rem;
  color: var(--color-texto-secundario);
}

.resumen-compras-barra strong {
  color: var(--color-texto);
}

.grid-tiendas {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
  gap: 18px;
}

.tarjeta-tienda {
  background-color: var(--color-superficie);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-grande);
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.tarjeta-tienda__cabecera {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--color-borde);
}

.tarjeta-tienda__nombre {
  font-size: 1.05rem;
}

.tarjeta-tienda__subtotal {
  font-weight: 700;
  font-size: 0.94rem;
  color: var(--color-primario);
}

.lista-ingredientes {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
}

.item-compra {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-block: 10px;
  border-bottom: 1px solid var(--color-superficie-alt);
}

.item-compra:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.item-compra__label {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  cursor: pointer;
  flex: 1;
}

.item-compra__label input[type="checkbox"] {
  width: 18px;
  height: 18px;
  margin-top: 2px;
  accent-color: var(--color-primario);
  cursor: pointer;
  flex-shrink: 0;
}

.item-compra__nombre {
  display: block;
  font-weight: 500;
  color: var(--color-texto);
}

.item-compra__cantidad {
  display: block;
  font-size: 0.8rem;
  color: var(--color-texto-suave);
}

.item-compra__precio {
  font-weight: 600;
  font-size: 0.88rem;
  color: var(--color-texto-secundario);
  white-space: nowrap;
}

.item-compra--comprado .item-compra__nombre {
  text-decoration: line-through;
  color: var(--color-texto-suave);
}

.item-compra--comprado .item-compra__precio {
  color: var(--color-exito);
}

/* ==========================================================================
   Sección 4: Despensa y recetas por caducidad
   ========================================================================== */
.layout-despensa {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
  gap: 24px;
  align-items: start;
}

.panel-despensa,
.panel-recetas-despensa {
  background-color: var(--color-superficie);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-grande);
  padding: 20px;
}

.subtitulo-bloque {
  font-size: 1.12rem;
  margin-bottom: 6px;
}

.texto-ayuda-suave {
  font-size: 0.86rem;
  color: var(--color-texto-suave);
  margin-bottom: 16px;
}

.formulario-despensa {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-bottom: 18px;
  margin-bottom: 16px;
  border-bottom: 1px solid var(--color-borde);
}

.fila-despensa-inputs {
  display: grid;
  grid-template-columns: 1.4fr 0.8fr 1fr;
  gap: 10px;
}

.campo-compacto {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.etiqueta-pequena {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--color-texto-secundario);
}

.lista-despensa {
  display: flex;
  flex-direction: column;
}

.item-despensa {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-block: 11px;
  border-bottom: 1px solid var(--color-superficie-alt);
}

.item-despensa:last-child {
  border-bottom: none;
}

.item-despensa__info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.item-despensa__nombre {
  font-weight: 600;
