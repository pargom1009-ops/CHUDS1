/* Presentación minimalista de una sola página, pensada primero para teléfono */
:root {
  --color-fondo: #f5f6f4;
  --color-superficie: #ffffff;
  --color-superficie-alt: #f1f3f0;
  --color-borde: #e6e9e5;
  --color-borde-fuerte: #d7ddd7;
  --color-primario: #1c6b4a;
  --radio-chico: 12px;
  --radio-medio: 18px;
  --radio-grande: 24px;
}
html { scroll-padding-top: 82px; }
body {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 88% 3%, rgb(226 240 230 / 78%), transparent 28rem),
    radial-gradient(ellipse at 4% 38%, rgb(238 241 235 / 70%), transparent 24rem),
    var(--color-fondo);
}
.barra-superior {
  position: sticky;
  top: 0;
  border: 0;
