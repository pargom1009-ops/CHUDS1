<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Planeador de Comida y Despensa</title>
  <meta name="description" content="Planea tu menú semanal en pesos mexicanos, arma tu lista de compras por tienda, controla tu despensa y aprovecha lo que caduca primero." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <!-- Barra superior de navegación (3 zonas: marca, enlaces y acción principal) -->
  <header class="barra-superior">
    <div class="contenedor barra-superior__interior">
      <a href="#seccion-familia" class="marca">Mesa<span class="marca__punto">.</span></a>

      <nav class="navegacion" aria-label="Navegación principal">
        <a href="#seccion-familia" class="navegacion__enlace activo" data-vista="familia">Familia</a>
        <a href="#seccion-menu" class="navegacion__enlace" data-vista="menu">Menú</a>
        <a href="#seccion-compras" class="navegacion__enlace" data-vista="compras">Compras</a>
        <a href="#seccion-despensa" class="navegacion__enlace" data-vista="despensa">Despensa</a>
        <a href="#seccion-favoritos" class="navegacion__enlace" data-vista="favoritos">Favoritos</a>
      </nav>

      <button type="button" id="btn-generar-header" class="boton boton--primario">
        Planear semana
      </button>
    </div>
  </header>

  <main class="contenedor contenido-principal">
    <!-- Resumen fijo de presupuesto semanal -->
    <section class="panel-resumen" aria-label="Resumen de presupuesto semanal">
      <div class="panel-resumen__metricas">
        <div class="metrica">
          <span class="metrica__etiqueta">Presupuesto semanal</span>
          <strong class="metrica__valor numero" id="resumen-presupuesto">$1,500 MXN</strong>
        </div>
        <div class="metrica">
          <span class="metrica__etiqueta">Costo estimado del menú</span>
          <strong class="metrica__valor numero" id="resumen-costo">$0 MXN</strong>
        </div>
        <div class="metrica">
          <span class="metrica__etiqueta">Diferencia</span>
          <strong class="metrica__valor numero" id="resumen-diferencia">$1,500 MXN</strong>
        </div>
        <div class="metrica">
          <span class="metrica__etiqueta">Porciones por comida</span>
          <strong class="metrica__valor numero" id="resumen-personas">4 personas</strong>
        </div>
      </div>

      <div class="barra-progreso-contenedor" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="barra-presupuesto-aria">
        <div class="barra-progreso__relleno" id="barra-presupuesto"></div>
      </div>

      <div class="alerta-presupuesto" id="alerta-presupuesto" role="status" aria-live="polite">
        Configura los datos de tu familia y genera tu menú semanal.
      </div>
    </section>

    <!-- Navegación por pestañas para móvil y escritorio -->
    <div class="pestanas" role="tablist" aria-label="Secciones del planeador">
      <button type="button" role="tab" aria-selected="true" class="pestana activa" data-vista="familia">1. Familia y presupuesto</button>
      <button type="button" role="tab" aria-selected="false" class="pestana" data-vista="menu">2. Menú semanal</button>
      <button type="button" role="tab" aria-selected="false" class="pestana" data-vista="compras">3. Lista de compras</button>
      <button type="button" role="tab" aria-selected="false" class="pestana" data-vista="despensa">4. Despensa y recetas</button>
      <button type="button" role="tab" aria-selected="false" class="pestana" data-vista="favoritos">5. Favoritos y asistente</button>
    </div>

    <!-- SECCIÓN 1: FAMILIA Y PRESUPUESTO -->
    <section id="seccion-familia" class="seccion-vista activa" aria-labelledby="titulo-familia">
      <div class="encabezado-seccion">
        <div>
          <h1 id="titulo-familia" class="titulo-seccion">Datos de tu familia y presupuesto</h1>
          <p class="descripcion-seccion">Captura cuánto planeas gastar, cuántas personas comen en casa, sus gustos, alergias y tus tiendas habituales. Todo se guarda automáticamente en tu navegador.</p>
        </div>
      </div>

      <form id="form-perfil" class="formulario-grid" novalidate>
        <div class="bloque-campo">
          <label for="input-presupuesto" class="etiqueta-campo">Presupuesto semanal (pesos mexicanos)</label>
          <div class="campo-prefijo">
            <span class="campo-prefijo__simbolo" aria-hidden="true">$</span>
            <input type="number" id="input-presupuesto" name="presupuesto" min="200" max="50000" step="50" value="1500" required />
            <span class="campo-prefijo__sufijo">MXN</span>
          </div>
          <p class="ayuda-campo">Ejemplo: $1,200 a $2,500 MXN para una familia de 4 personas.</p>
        </div>

        <div class="bloque-campo">
          <label for="input-personas" class="etiqueta-campo">Personas en la familia</label>
          <input type="number" id="input-personas" name="personas" min="1" max="15" step="1" value="4" required />
          <p class="ayuda-campo">Las porciones y cantidades de la lista de compras se escalan automáticamente.</p>
        </div>

        <div class="bloque-campo bloque-campo--completo">
          <label for="input-gustos" class="etiqueta-campo">¿Qué comidas les gustan?</label>
          <input type="text" id="input-gustos" name="gustos" placeholder="Ej. comida mexicana, pollo, verduras, pasta, económico, rápido" />
          <div class="opciones-rapidas" id="gustos-rapidos" aria-label="Sugerencias rápidas de gustos">
            <button type="button" class="boton-opcion" data-gusto="mexicana">Comida mexicana</button>
            <button type="button" class="boton-opcion" data-gusto="pollo">Pollo</button>
            <button type="button" class="boton-opcion" data-gusto="verduras">Verduras</button>
            <button type="button" class="boton-opcion" data-gusto="economico">Económico</button>
            <button type="button" class="boton-opcion" data-gusto="rapido">Rápido</button>
            <button type="button" class="boton-opcion" data-gusto="vegetariano">Sin carne</button>
            <button type="button" class="boton-opcion" data-gusto="pasta">Pastas y sopas</button>
          </div>
        </div>

        <div class="bloque-campo bloque-campo--completo">
          <fieldset class="grupo-opciones">
            <legend class="etiqueta-campo">¿Qué no comen o a qué son alérgicos?</legend>
            <div class="rejilla-checks" id="checks-restricciones">
              <label class="check-caja"><input type="checkbox" value="lacteos" /> Lácteos</label>
              <label class="check-caja"><input type="checkbox" value="gluten" /> Gluten / trigo</label>
              <label class="check-caja"><input type="checkbox" value="mariscos" /> Mariscos y pescado</label>
              <label class="check-caja"><input type="checkbox" value="cerdo" /> Carne de cerdo</label>
              <label class="check-caja"><input type="checkbox" value="res" /> Carne de res</label>
              <label class="check-caja"><input type="checkbox" value="huevo" /> Huevo</label>
              <label class="check-caja"><input type="checkbox" value="picante" /> Picante</label>
              <label class="check-caja"><input type="checkbox" value="nueces" /> Nueces y cacahuate</label>
            </div>
            <label for="input-restricciones-extra" class="etiqueta-secundaria">Otros ingredientes que prefieren evitar (separados por coma)</label>
            <input type="text" id="input-restricciones-extra" placeholder="Ej. cebolla, champiñones, cilantro" />
          </fieldset>
        </div>

        <div class="bloque-campo bloque-campo--completo">
          <fieldset class="grupo-opciones">
            <legend class="etiqueta-campo">Tiendas donde compras normalmente</legend>
            <div class="rejilla-checks" id="checks-tiendas">
              <label class="check-caja"><input type="checkbox" value="Walmart" checked /> Walmart</label>
              <label class="check-caja"><input type="checkbox" value="Soriana" /> Soriana</label>
              <label class="check-caja"><input type="checkbox" value="Mercado" checked /> Mercado</label>
              <label class="check-caja"><input type="checkbox" value="Tianguis" checked /> Tianguis</label>
              <label class="check-caja"><input type="checkbox" value="Chedraui" /> Chedraui</label>
              <label class="check-caja"><input type="checkbox" value="Bodega Aurrera" /> Bodega Aurrera</label>
            </div>
            <div class="agregar-tienda-fila">
              <label for="input-tienda-nueva" class="sr-only">Agregar otra tienda</label>
              <input type="text" id="input-tienda-nueva" placeholder="Agregar otra tienda (ej. Abarrotes Don Pepe)" />
              <button type="button" id="btn-agregar-tienda" class="boton boton--secundario">Agregar tienda</button>
            </div>
          </fieldset>
        </div>

        <div class="acciones-formulario bloque-campo--completo">
          <button type="submit" class="boton boton--primario">Guardar y generar menú semanal</button>
          <button type="button" id="btn-restaurar-ejemplo" class="boton boton--texto">Cargar ejemplo inicial</button>
        </div>
      </form>
    </section>

    <!-- SECCIÓN 2: MENÚ SEMANAL -->
    <section id="seccion-menu" class="seccion-vista" aria-labelledby="titulo-menu">
      <div class="encabezado-seccion">
        <div>
          <h2 id="titulo-menu" class="titulo-seccion">Menú semanal</h2>
          <p class="descripcion-seccion" id="subtitulo-menu">Desayuno, comida y cena para toda la semana. Elige entre más de 40 recetas y mantente cerca de tu presupuesto.</p>
        </div>
        <div class="acciones-seccion">
          <button type="button" id="btn-regenerar-menu" class="boton boton--primario">Generar otro menú</button>
          <button type="button" id="btn-optimizar-presupuesto" class="boton boton--secundario">Ajustar al presupuesto</button>
        </div>
      </div>

      <!-- Sustitutos económicos recomendados si aplica -->
      <div id="contenedor-sustitutos-menu" class="panel-sustitutos oculto" aria-live="polite"></div>

      <!-- Cuadrícula de los 7 días -->
      <div id="grid-menu-semanal" class="grid-menu"></div>
    </section>

    <!-- SECCIÓN 3: LISTA DE COMPRAS POR TIENDA -->
    <section id="seccion-compras" class="seccion-vista" aria-labelledby="titulo-compras">
      <div class="encabezado-seccion">
        <div>
          <h2 id="titulo-compras" class="titulo-seccion">Lista de compras por tienda</h2>
          <p class="descripcion-seccion">Marca lo que ya compraste o ya tienes en casa: se pasará automáticamente a tu despensa y se descontará de lo que te falta pagar.</p>
        </div>
        <div class="acciones-seccion">
          <button type="button" id="btn-copiar-lista" class="boton boton--secundario">Copiar lista</button>
          <button type="button" id="btn-imprimir-lista" class="boton boton--secundario">Imprimir</button>
          <button type="button" id="btn-desmarcar-lista" class="boton boton--texto">Desmarcar todo</button>
        </div>
      </div>

      <div class="resumen-compras-barra" id="resumen-compras-barra"></div>

      <!-- Sustitutos más baratos para ingredientes de la lista -->
      <div id="contenedor-sustitutos-lista" class="panel-sustitutos oculto"></div>

      <!-- Listas agrupadas por tienda -->
      <div id="grid-lista-compras" class="grid-tiendas"></div>
    </section>

    <!-- SECCIÓN 4: DESPENSA Y RECETAS POR CADUCIDAD -->
    <section id="seccion-despensa" class="seccion-vista" aria-labelledby="titulo-despensa">
      <div class="encabezado-seccion">
        <div>
          <h2 id="titulo-despensa" class="titulo-seccion">Mi despensa y recetas recomendadas</h2>
          <p class="descripcion-seccion">Registra lo que compraste o tienes en la alacena. Priorizamos recetas con los ingredientes que se echan a perder primero.</p>
        </div>
      </div>

      <div class="layout-despensa">
        <!-- Columna izquierda: Inventario de despensa -->
        <div class="panel-despensa">
          <h3 class="subtitulo-bloque">Ingredientes disponibles</h3>

          <form id="form-despensa" class="formulario-despensa">
            <div class="fila-despensa-inputs">
              <div class="campo-compacto">
                <label for="despensa-nombre" class="etiqueta-pequena">Ingrediente</label>
                <input type="text" id="despensa-nombre" placeholder="Ej. Jitomate, pollo, espinaca" required />
              </div>
              <div class="campo-compacto campo-compacto--chico">
                <label for="despensa-cantidad" class="etiqueta-pequena">Cantidad</label>
                <input type="text" id="despensa-cantidad" placeholder="Ej. 500 g" value="1 pza" required />
              </div>
              <div class="campo-compacto">
                <label for="despensa-caducidad" class="etiqueta-pequena">¿Cuánto dura?</label>
                <select id="despensa-caducidad">
                  <option value="2">Urgente (1 a 2 días)</option>
                  <option value="4" selected>Pronto (3 a 5 días)</option>
                  <option value="14">Duradero (1 a 2 semanas)</option>
                  <option value="60">Alacena (más de 1 mes)</option>
                </select>
              </div>
            </div>
            <button type="submit" class="boton boton--primario">Agregar a mi despensa</button>
          </form>

          <div id="lista-despensa" class="lista-despensa"></div>
        </div>

        <!-- Columna derecha: Recetas sugeridas priorizando caducidad -->
        <div class="panel-recetas-despensa">
          <h3 class="subtitulo-bloque">Recetas sugeridas con tu despensa</h3>
          <p class="texto-ayuda-suave">Ordenadas primero por ingredientes que se echan a perder más rápido y luego por mayor coincidencia con tu alacena.</p>
          <div id="lista-recetas-despensa" class="lista-recetas-sugeridas"></div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 5: FAVORITOS Y ASISTENTE IA -->
    <section id="seccion-favoritos" class="seccion-vista" aria-labelledby="titulo-favoritos">
      <div class="encabezado-seccion">
        <div>
          <h2 id="titulo-favoritos" class="titulo-seccion">Platillos favoritos y asistente de cocina</h2>
          <p class="descripcion-seccion">Guarda los platillos que más le gustan a tu familia y consulta sugerencias inteligentes basadas en tu presupuesto y despensa.</p>
        </div>
      </div>

      <div class="bloque-favoritos">
        <h3 class="subtitulo-bloque">Tus platillos favoritos</h3>
        <div id="grid-favoritos" class="grid-favoritos"></div>
      </div>

      <hr class="divisor" />

      <!-- Módulo del Asistente IA (preparado para conectar a Claude vía asistente.js) -->
      <section class="bloque-asistente" aria-labelledby="titulo-asistente">
        <div class="encabezado-asistente">
          <div>
            <h3 id="titulo-asistente" class="subtitulo-bloque">Asistente de menú y ahorro</h3>
            <p class="texto-ayuda-suave">Genera recomendaciones personalizadas con los datos de tu familia, tiendas y despensa. Actualmente usa el módulo local <code>asistente.js</code>, listo para conectarse a Claude.</p>
          </div>
          <button type="button" id="btn-consultar-asistente" class="boton boton--primario">
            Pedir sugerencias al asistente
          </button>
        </div>

        <div id="resultado-asistente" class="resultado-asistente">
          <p class="estado-vacio">Presiona "Pedir sugerencias al asistente" para recibir ideas de menú económico, recetas de aprovechamiento y sustituciones personalizadas.</p>
        </div>
      </section>
    </section>
    <section class="preferencias-extra tarjeta-preferencias" aria-labelledby="titulo-objetivo">
  <div class="preferencias-extra__encabezado">
    <div>
      <h2 id="titulo-objetivo" class="titulo-seccion titulo-seccion--compacto">
        Tu objetivo de alimentación
      </h2>
      <p class="descripcion-seccion">
        Elige el enfoque que quieres tener presente al planear tus comidas.
      </p>
    </div>
  </div>

  <div class="objetivos-grid" role="group" aria-label="Objetivo actual">
    <button type="button" class="objetivo-opcion"
      data-objetivo="ahorro" aria-pressed="false">
      <span class="objetivo-opcion__icono" aria-hidden="true">$</span>
      <span class="objetivo-opcion__texto">
        <strong>Modo Ahorro</strong>
        <small>Prioriza ingredientes rendidores y económicos.</small>
      </span>
    </button>

    <button type="button" class="objetivo-opcion"
      data-objetivo="antojos" aria-pressed="false">
      <span class="objetivo-opcion__icono" aria-hidden="true">♡</span>
      <span class="objetivo-opcion__texto">
        <strong>Antojos</strong>
        <small>Da espacio a tus platillos favoritos.</small>
      </span>
    </button>

    <button type="button" class="objetivo-opcion"
      data-objetivo="saludable" aria-pressed="false">
      <span class="objetivo-opcion__icono" aria-hidden="true">＋</span>
      <span class="objetivo-opcion__texto">
        <strong>Saludable</strong>
        <small>Más proteínas y comidas equilibradas.</small>
      </span>
    </button>
  </div>

  <p class="ayuda-campo" id="estado-objetivo" aria-live="polite">
    Selecciona un objetivo para guardarlo en este navegador.
  </p>
</section>

<section class="preferencias-extra dieta-panel" aria-labelledby="titulo-dieta">
  <div class="preferencias-extra__encabezado">
    <div>
      <h2 id="titulo-dieta" class="titulo-seccion titulo-seccion--compacto">
        Preferencia de dieta
      </h2>
      <p class="descripcion-seccion">
        Selecciona los filtros que quieres considerar. La tabla muestra una referencia diaria estimada por persona.
      </p>
    </div>
  </div>

  <fieldset class="dieta-filtros">
    <legend class="etiqueta-campo">Filtros de alimentación</legend>
    <div class="dieta-filtros__lista">
      <label class="check-caja">
        <input type="checkbox" name="filtro-dieta" value="vegetariana"> Vegetariana
      </label>
      <label class="check-caja">
        <input type="checkbox" name="filtro-dieta" value="vegana"> Vegana
      </label>
      <label class="check-caja">
        <input type="checkbox" name="filtro-dieta" value="baja-carbohidratos"> Baja en carbohidratos
      </label>
      <label class="check-caja">
        <input type="checkbox" name="filtro-dieta" value="sin-gluten"> Sin gluten
      </label>
      <label class="check-caja">
        <input type="checkbox" name="filtro-dieta" value="sin-lactosa"> Sin lactosa
      </label>
    </div>
  </fieldset>

  <div class="tabla-nutrimental-contenedor">
    <table class="tabla-nutrimental">
      <caption id="tabla-nutrimental-caption">
        Referencia diaria aproximada · por persona
      </caption>
      <thead>
        <tr>
          <th scope="col">Nutrimento</th>
          <th scope="col">Referencia</th>
        </tr>
      </thead>
      <tbody>
        <tr><th scope="row">Calorías</th><td>2,000 kcal</td></tr>
        <tr><th scope="row">Proteínas</th><td>75 g</td></tr>
        <tr><th scope="row">Carbohidratos</th><td>250 g</td></tr>
        <tr><th scope="row">Grasas</th><td>67 g</td></tr>
      </tbody>
    </table>
  </div>

  <p class="ayuda-campo" id="estado-dieta" aria-live="polite">
    Las cifras son orientativas y no sustituyen una recomendación nutricional personalizada.
  </p>
</section>
  </main>

  <!-- Modal sencillo para ver detalle de receta o cambiar platillo -->
  <dialog id="modal-receta" class="modal">
    <div class="modal__contenido">
      <div class="modal__cabecera">
        <h3 id="modal-titulo" class="modal__titulo">Detalle del platillo</h3>
        <button type="button" id="btn-cerrar-modal" class="boton-cerrar" aria-label="Cerrar ventana">&times;</button>
      </div>
      <div id="modal-cuerpo" class="modal__cuerpo"></div>
    </div>
  </dialog>

  <!-- Notificación discreta (toast) para confirmar acciones -->
  <div id="notificacion" class="notificacion" role="status" aria-live="polite" aria-atomic="true"></div>

  <footer class="pie-pagina">
    <div class="contenedor pie-pagina__interior">
      <span>Planeador de Comida y Despensa · Datos guardados localmente en este navegador</span>
      <button type="button" id="btn-borrar-todo" class="boton-enlace-peligro">Reiniciar datos guardados</button>
    </div>
  </footer>

  <!-- Scripts en JavaScript puro: primero el módulo del asistente, luego la aplicación -->
  <script src="asistente.js"></script>
  <script src="app.js"></script>
  <script src="preferencias.js"></script>
</body>
</html>

==================== styles.css ====================

/* ==========================================================================
   Planeador de Comida y Despensa — Estilos puros en CSS
   Sistema de diseño limpio, responsivo y con variables para colores.
   ========================================================================== */

:root {
  /* Paleta neutra (60% fondo, 30% superficies y bordes) */
  --color-fondo: #f7f8f7;
  --color-superficie: #ffffff;
  --color-superficie-alt: #f1f4f2;
  --color-borde: #dfe5e1;
  --color-borde-fuerte: #c5d0c9;

  /* Tipografía */
  --color-texto: #142019;
  --color-texto-secundario: #4b5c52;
  --color-texto-suave: #66786d;

  /* Acento principal (10% del presupuesto visual) */
  --color-primario: #1b6b4a;
  --color-primario-hover: #145339;
  --color-primario-suave: #ebf6f0;

  /* Colores semánticos (siempre acompañados de texto explícito) */
  --color-exito: #157347;
  --color-exito-fondo: #edf8f2;
  --color-aviso: #a15c07;
  --color-aviso-fondo: #fef7eb;
  --color-peligro: #b42318;
  --color-peligro-fondo: #fef2f2;

  /* Fuentes */
  --fuente-titulos: "Plus Jakarta Sans", system-ui, -apple-system, sans-serif;
  --fuente-cuerpo: "DM Sans", system-ui, -apple-system, sans-serif;

  /* Radios y espaciado */
  --radio-chico: 6px;
  --radio-medio: 10px;
  --radio-grande: 14px;
  --transicion: 160ms cubic-bezier(0.16, 1, 0.3, 1);
}

/* Reinicio básico */
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: var(--fuente-cuerpo);
  font-size: 15px;
  line-height: 1.55;
  color: var(--color-texto);
  background-color: var(--color-fondo);
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3, h4 {
  margin: 0;
  font-family: var(--fuente-titulos);
  font-weight: 700;
  line-height: 1.25;
  color: var(--color-texto);
  text-wrap: balance;
}

p {
  margin: 0;
}

button,
input,
select {
  font-family: inherit;
  font-size: inherit;
}

:focus-visible {
  outline: 2px solid var(--color-primario);
  outline-offset: 2px;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.oculto {
  display: none !important;
}

.numero {
  font-variant-numeric: tabular-nums;
}

/* Contenedor principal */
.contenedor {
  width: 100%;
  max-width: 1180px;
  margin-inline: auto;
  padding-inline: 20px;
}

/* ==========================================================================
   Barra superior (3 zonas en una sola línea)
   ========================================================================== */
.barra-superior {
  position: sticky;
  top: 0;
  z-index: 30;
  background-color: var(--color-superficie);
  border-bottom: 1px solid var(--color-borde);
}

.barra-superior__interior {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  min-height: 64px;
}

.marca {
  font-family: var(--fuente-titulos);
  font-size: 1.05rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--color-texto);
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
}

.navegacion {
  display: flex;
  align-items: center;
  gap: 22px;
}

.navegacion__enlace {
  font-size: 0.92rem;
  font-weight: 500;
  color: var(--color-texto-secundario);
  text-decoration: none;
  padding-block: 6px;
  border-bottom: 2px solid transparent;
  white-space: nowrap;
  flex-shrink: 0;
  transition: color var(--transicion), border-color var(--transicion);
}

.navegacion__enlace:hover,
.navegacion__enlace.activo {
  color: var(--color-texto);
  border-bottom-color: var(--color-primario);
}

/* ==========================================================================
   Botones
   ========================================================================== */
.boton {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 40px;
  padding: 9px 18px;
  border-radius: var(--radio-chico);
  border: 1px solid transparent;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  flex-shrink: 0;
  transition: background-color var(--transicion), border-color var(--transicion), color var(--transicion), transform var(--transicion);
}

.boton:active {
  transform: translateY(1px);
}

.boton--primario {
  background-color: var(--color-primario);
  color: #ffffff;
}

.boton--primario:hover {
  background-color: var(--color-primario-hover);
}

.boton--secundario {
  background-color: var(--color-superficie);
  color: var(--color-texto);
  border-color: var(--color-borde-fuerte);
}

.boton--secundario:hover {
  background-color: var(--color-superficie-alt);
}

.boton--texto {
  background-color: transparent;
  color: var(--color-texto-secundario);
  padding-inline: 10px;
}

.boton--texto:hover {
  color: var(--color-texto);
  background-color: var(--color-superficie-alt);
}

.boton--chico {
  min-height: 34px;
  padding: 6px 12px;
  font-size: 0.82rem;
}

/* ==========================================================================
   Contenido principal y Panel de presupuesto
   ========================================================================== */
.contenido-principal {
  padding-block: 24px 56px;
}

.panel-resumen {
  background-color: var(--color-superficie);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-grande);
  padding: 20px 24px;
  margin-bottom: 20px;
}

.panel-resumen__metricas {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 14px;
}

.metrica {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.metrica__etiqueta {
  font-size: 0.8rem;
  color: var(--color-texto-suave);
}

.metrica__valor {
  font-family: var(--fuente-titulos);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--color-texto);
}

.metrica__valor--exito {
  color: var(--color-exito);
}

.metrica__valor--peligro {
  color: var(--color-peligro);
}

.barra-progreso-contenedor {
  width: 100%;
  height: 8px;
  background-color: var(--color-superficie-alt);
  border-radius: 999px;
  overflow: hidden;
  margin-bottom: 12px;
}

.barra-progreso__relleno {
  height: 100%;
  width: 0%;
  background-color: var(--color-primario);
  border-radius: 999px;
  transition: width 260ms ease, background-color 200ms ease;
}

.barra-progreso__relleno--aviso {
  background-color: var(--color-aviso);
}

.barra-progreso__relleno--peligro {
  background-color: var(--color-peligro);
}

.alerta-presupuesto {
  font-size: 0.9rem;
  padding: 10px 14px;
  border-radius: var(--radio-chico);
  background-color: var(--color-superficie-alt);
  color: var(--color-texto-secundario);
}

.alerta-presupuesto--exito {
  background-color: var(--color-exito-fondo);
  color: var(--color-exito);
}

.alerta-presupuesto--aviso {
  background-color: var(--color-aviso-fondo);
  color: var(--color-aviso);
}

.alerta-presupuesto--peligro {
  background-color: var(--color-peligro-fondo);
  color: var(--color-peligro);
  font-weight: 500;
}

/* ==========================================================================
   Pestañas de secciones
   ========================================================================== */
.pestanas {
  display: flex;
  gap: 6px;
  padding: 5px;
  background-color: var(--color-superficie-alt);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-medio);
  margin-bottom: 24px;
  overflow-x: auto;
  scrollbar-width: thin;
}

.pestana {
  flex: 1 0 auto;
  min-height: 40px;
  padding: 8px 14px;
  border: none;
  border-radius: var(--radio-chico);
  background: transparent;
  color: var(--color-texto-secundario);
  font-size: 0.88rem;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: background-color var(--transicion), color var(--transicion);
}

.pestana:hover {
  color: var(--color-texto);
}

.pestana.activa {
  background-color: var(--color-superficie);
  color: var(--color-texto);
  box-shadow: 0 1px 2px rgba(20, 32, 25, 0.08);
}

/* ==========================================================================
   Secciones y encabezados
   ========================================================================== */
.seccion-vista {
  display: none;
}

.seccion-vista.activa {
  display: block;
}

.encabezado-seccion {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 22px;
  flex-wrap: wrap;
}

.titulo-seccion {
  font-size: 1.55rem;
  margin-bottom: 6px;
}

.descripcion-seccion {
  color: var(--color-texto-secundario);
  max-width: 68ch;
  font-size: 0.94rem;
}

.acciones-seccion {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

/* ==========================================================================
   Sección 1: Formulario de familia y presupuesto
   ========================================================================== */
.formulario-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  background-color: var(--color-superficie);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-grande);
  padding: 24px;
}

.bloque-campo {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.bloque-campo--completo {
  grid-column: 1 / -1;
}

.etiqueta-campo {
  font-weight: 600;
  font-size: 0.92rem;
  color: var(--color-texto);
}

.etiqueta-secundaria {
  font-size: 0.84rem;
  color: var(--color-texto-secundario);
  margin-top: 8px;
}

.ayuda-campo {
  font-size: 0.82rem;
  color: var(--color-texto-suave);
}

input[type="text"],
input[type="number"],
select {
  width: 100%;
  min-height: 42px;
  padding: 9px 12px;
  border: 1px solid var(--color-borde-fuerte);
  border-radius: var(--radio-chico);
  background-color: var(--color-superficie);
  color: var(--color-texto);
  transition: border-color var(--transicion);
}

input[type="text"]:focus,
input[type="number"]:focus,
select:focus {
  border-color: var(--color-primario);
  outline: none;
}

.campo-prefijo {
  display: flex;
  align-items: center;
  border: 1px solid var(--color-borde-fuerte);
  border-radius: var(--radio-chico);
  background-color: var(--color-superficie);
  overflow: hidden;
}

.campo-prefijo:focus-within {
  border-color: var(--color-primario);
}

.campo-prefijo input {
  border: none;
  min-height: 40px;
}

.campo-prefijo__simbolo,
.campo-prefijo__sufijo {
  padding-inline: 12px;
  font-size: 0.86rem;
  font-weight: 600;
  color: var(--color-texto-suave);
  background-color: var(--color-superficie-alt);
  align-self: stretch;
  display: flex;
  align-items: center;
}

.opciones-rapidas {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 4px;
}

.boton-opcion {
  min-height: 34px;
  padding: 5px 12px;
  border: 1px solid var(--color-borde-fuerte);
  border-radius: var(--radio-chico);
  background-color: var(--color-superficie);
  color: var(--color-texto-secundario);
  font-size: 0.84rem;
  cursor: pointer;
  transition: background-color var(--transicion), border-color var(--transicion), color var(--transicion);
}

.boton-opcion:hover {
  border-color: var(--color-primario);
  color: var(--color-texto);
}

.boton-opcion.seleccionado {
  background-color: var(--color-primario-suave);
  border-color: var(--color-primario);
  color: var(--color-primario);
  font-weight: 600;
}

.grupo-opciones {
  border: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.rejilla-checks {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
  gap: 10px;
}

.check-caja {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 40px;
  padding: 8px 12px;
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-chico);
  background-color: var(--color-superficie);
  font-size: 0.9rem;
  cursor: pointer;
  transition: border-color var(--transicion), background-color var(--transicion);
}

.check-caja:hover {
  background-color: var(--color-superficie-alt);
}

.check-caja input[type="checkbox"] {
  width: 17px;
  height: 17px;
  accent-color: var(--color-primario);
  cursor: pointer;
}

.agregar-tienda-fila {
  display: flex;
  gap: 10px;
  margin-top: 4px;
}

.acciones-formulario {
  display: flex;
  align-items: center;
  gap: 14px;
  padding-top: 8px;
  border-top: 1px solid var(--color-borde);
  flex-wrap: wrap;
}

/* ==========================================================================
   Sección 2: Menú semanal
   ========================================================================== */
.panel-sustitutos {
  background-color: var(--color-aviso-fondo);
  border: 1px solid #f0d7b1;
  border-radius: var(--radio-medio);
  padding: 16px 20px;
  margin-bottom: 20px;
}

.panel-sustitutos__titulo {
  font-size: 0.96rem;
  color: var(--color-aviso);
  margin-bottom: 10px;
}

.lista-sustitutos {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.item-sustituto {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding-top: 10px;
  border-top: 1px solid rgba(161, 92, 7, 0.16);
  flex-wrap: wrap;
}

.item-sustituto:first-child {
  padding-top: 0;
  border-top: none;
}

.item-sustituto__texto {
  font-size: 0.9rem;
  color: var(--color-texto);
}

.item-sustituto__ahorro {
  font-size: 0.84rem;
  color: var(--color-exito);
  font-weight: 600;
}

.grid-menu {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
  gap: 18px;
}

.tarjeta-dia {
  background-color: var(--color-superficie);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-grande);
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.tarjeta-dia__cabecera {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--color-borde);
}

.tarjeta-dia__nombre {
  font-size: 1.05rem;
}

.tarjeta-dia__total {
  font-size: 0.86rem;
  font-weight: 600;
  color: var(--color-texto-secundario);
}

.comida-bloque {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--color-superficie-alt);
}

.comida-bloque:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.comida-bloque__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.78rem;
  color: var(--color-texto-suave);
}

.comida-bloque__fila {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}

.comida-bloque__titulo {
  font-weight: 600;
  font-size: 0.96rem;
  color: var(--color-texto);
  background: none;
  border: none;
  padding: 0;
  text-align: left;
  cursor: pointer;
}

.comida-bloque__titulo:hover {
  color: var(--color-primario);
  text-decoration: underline;
}

.comida-bloque__acciones {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.boton-icono {
  min-width: 32px;
  min-height: 32px;
  padding: 4px 8px;
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-chico);
  background-color: var(--color-superficie);
  color: var(--color-texto-secundario);
  font-size: 0.8rem;
  cursor: pointer;
  transition: background-color var(--transicion), color var(--transicion), border-color var(--transicion);
}

.boton-icono:hover {
  background-color: var(--color-superficie-alt);
  color: var(--color-texto);
}

.boton-icono.favorito-activo {
  color: #b45309;
  border-color: #eab308;
  background-color: #fefce8;
}

/* ==========================================================================
   Sección 3: Lista de compras por tienda
   ========================================================================== */
.resumen-compras-barra {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  background-color: var(--color-superficie);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-medio);
  padding: 14px 18px;
  margin-bottom: 20px;
  font-size: 0.9rem;
  color: var(--color-texto-secundario);
}

.resumen-compras-barra strong {
  color: var(--color-texto);
}

.grid-tiendas {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
  gap: 18px;
}

.tarjeta-tienda {
  background-color: var(--color-superficie);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-grande);
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.tarjeta-tienda__cabecera {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--color-borde);
}

.tarjeta-tienda__nombre {
  font-size: 1.05rem;
}

.tarjeta-tienda__subtotal {
  font-weight: 700;
  font-size: 0.94rem;
  color: var(--color-primario);
}

.lista-ingredientes {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
}

.item-compra {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-block: 10px;
  border-bottom: 1px solid var(--color-superficie-alt);
}

.item-compra:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.item-compra__label {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  cursor: pointer;
  flex: 1;
}

.item-compra__label input[type="checkbox"] {
  width: 18px;
  height: 18px;
  margin-top: 2px;
  accent-color: var(--color-primario);
  cursor: pointer;
  flex-shrink: 0;
}

.item-compra__nombre {
  display: block;
  font-weight: 500;
  color: var(--color-texto);
}

.item-compra__cantidad {
  display: block;
  font-size: 0.8rem;
  color: var(--color-texto-suave);
}

.item-compra__precio {
  font-weight: 600;
  font-size: 0.88rem;
  color: var(--color-texto-secundario);
  white-space: nowrap;
}

.item-compra--comprado .item-compra__nombre {
  text-decoration: line-through;
  color: var(--color-texto-suave);
}

.item-compra--comprado .item-compra__precio {
  color: var(--color-exito);
}

/* ==========================================================================
   Sección 4: Despensa y recetas por caducidad
   ========================================================================== */
.layout-despensa {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
  gap: 24px;
  align-items: start;
}

.panel-despensa,
.panel-recetas-despensa {
  background-color: var(--color-superficie);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-grande);
  padding: 20px;
}

.subtitulo-bloque {
  font-size: 1.12rem;
  margin-bottom: 6px;
}

.texto-ayuda-suave {
  font-size: 0.86rem;
  color: var(--color-texto-suave);
  margin-bottom: 16px;
}

.formulario-despensa {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-bottom: 18px;
  margin-bottom: 16px;
  border-bottom: 1px solid var(--color-borde);
}

.fila-despensa-inputs {
  display: grid;
  grid-template-columns: 1.4fr 0.8fr 1fr;
  gap: 10px;
}

.campo-compacto {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.etiqueta-pequena {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--color-texto-secundario);
}

.lista-despensa {
  display: flex;
  flex-direction: column;
}

.item-despensa {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-block: 11px;
  border-bottom: 1px solid var(--color-superficie-alt);
}

.item-despensa:last-child {
  border-bottom: none;
}

.item-despensa__info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.item-despensa__nombre {
  font-weight: 600;
  font-size: 0.94rem;
}

.item-despensa__meta {
  font-size: 0.8rem;
  color: var(--color-texto-suave);
}

.caducidad-urgente {
  color: var(--color-peligro);
  font-weight: 600;
}

.caducidad-pronto {
  color: var(--color-aviso);
  font-weight: 600;
}

.caducidad-normal {
  color: var(--color-exito);
}

.lista-recetas-sugeridas {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.tarjeta-receta-sugerida {
  padding-bottom: 14px;
  border-bottom: 1px solid var(--color-borde);
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.tarjeta-receta-sugerida:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.tarjeta-receta-sugerida__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
}

.tarjeta-receta-sugerida__nombre {
  font-size: 1rem;
  font-weight: 700;
}

.tarjeta-receta-sugerida__meta {
  font-size: 0.82rem;
  color: var(--color-texto-suave);
}

.tarjeta-receta-sugerida__detalle {
  font-size: 0.88rem;
  color: var(--color-texto-secundario);
}

.aviso-aprovecha {
  font-size: 0.83rem;
  color: var(--color-peligro);
  font-weight: 600;
}

/* ==========================================================================
   Sección 5: Favoritos y Asistente IA
   ========================================================================== */
.grid-favoritos {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 16px;
  margin-top: 14px;
}

.tarjeta-favorito {
  background-color: var(--color-superficie);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-medio);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.tarjeta-favorito__meta {
  font-size: 0.82rem;
  color: var(--color-texto-suave);
}

.tarjeta-favorito__acciones {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: auto;
  padding-top: 8px;
  border-top: 1px solid var(--color-superficie-alt);
}

.divisor {
  border: none;
  border-top: 1px solid var(--color-borde);
  margin-block: 32px;
}

.bloque-asistente {
  background-color: var(--color-superficie);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-grande);
  padding: 24px;
}

.encabezado-asistente {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}

.resultado-asistente {
  border-top: 1px solid var(--color-borde);
  padding-top: 18px;
}

.asistente-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 20px;
  margin-top: 14px;
}

.asistente-columna h4 {
  font-size: 0.96rem;
  margin-bottom: 8px;
  color: var(--color-primario);
}

.asistente-lista {
  margin: 0;
  padding-left: 18px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 0.9rem;
  color: var(--color-texto-secundario);
}

.estado-vacio {
  color: var(--color-texto-suave);
  font-size: 0.92rem;
  padding-block: 12px;
}

/* ==========================================================================
   Modal de receta y Notificación
   ========================================================================== */
.modal {
  width: min(560px, calc(100% - 32px));
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-grande);
  padding: 0;
  background-color: var(--color-superficie);
  color: var(--color-texto);
  box-shadow: 0 20px 48px rgba(20, 32, 25, 0.18);
}

.modal::backdrop {
  background-color: rgba(20, 32, 25, 0.45);
}

.modal__contenido {
  padding: 22px 24px;
}

.modal__cabecera {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--color-borde);
  margin-bottom: 16px;
}

.modal__titulo {
  font-size: 1.2rem;
}

.boton-cerrar {
  width: 36px;
  height: 36px;
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-chico);
  background: transparent;
  font-size: 1.35rem;
  line-height: 1;
  color: var(--color-texto-secundario);
  cursor: pointer;
}

.boton-cerrar:hover {
  background-color: var(--color-superficie-alt);
  color: var(--color-texto);
}

.modal__cuerpo {
  display: flex;
  flex-direction: column;
  gap: 14px;
  font-size: 0.94rem;
}

.modal__lista {
  margin: 0;
  padding-left: 18px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.notificacion {
  position: fixed;
  bottom: 20px;
  right: 20px;
  z-index: 50;
  max-width: 360px;
  padding: 12px 16px;
  border-radius: var(--radio-chico);
  background-color: var(--color-texto);
  color: #ffffff;
  font-size: 0.88rem;
  opacity: 0;
  pointer-events: none;
  transform: translateY(10px);
  transition: opacity var(--transicion), transform var(--transicion);
}

.notificacion.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ==========================================================================
   Pie de página
   ========================================================================== */
.pie-pagina {
  border-top: 1px solid var(--color-borde);
  background-color: var(--color-superficie);
  padding-block: 18px;
  font-size: 0.84rem;
