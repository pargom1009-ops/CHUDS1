            ${respuesta.recetasAprovechamiento.map((item) => `<li>${item}</li>`).join("")}
          </ul>
        </div>
        <div class="asistente-columna">
          <h4>Consejos de ahorro</h4>
          <ul class="asistente-lista">
            ${respuesta.consejosAhorro.map((item) => `<li>${item}</li>`).join("")}
