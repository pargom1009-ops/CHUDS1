  function traducirCadena(texto) {
    if (idiomaActual === "es") return texto;
    const tabla = translationsForCurrentLanguage();
    const llave = texto.trim();
    if (tabla[llave]) return tabla[llave];
    const cuenta = llave.match(/^(\d+) (persona|personas)$/);
    if (cuenta) {
      const n = Number(cuenta[1]);
      if (idiomaActual === "en") return `${n} ${n === 1 ? "person" : "people"}`;
      return `${n} ${n === 1 ? "אדם" : "אנשים"}`;
    }
    let resultado = texto;
    const diccionarioTerminos = terms[idiomaActual] || {};
    Object.keys(diccionarioTerminos).sort((a, b) => b.length - a.length).forEach((original) => {
      resultado = resultado.split(original).join(diccionarioTerminos[original]);
    });
    return resultado;
  }

  function translationsForCurrentLanguage() { return idiomas[idiomaActual] || {}; }

  function traducirNodoTexto(nodo) {
    let registro = sourceText.get(nodo);
    if (!registro || nodo.nodeValue !== registro.traducido) {
      registro = { original: nodo.nodeValue, traducido: nodo.nodeValue };
      sourceText.set(nodo, registro);
    }
    const original = registro.original;
    const inicio = (original.match(/^\s*/) || [""])[0];
    const final = (original.match(/\s*$/) || [""])[0];
    const centro = original.slice(inicio.length, original.length - final.length || original.length);
    const traducido = `${inicio}${traducirCadena(centro)}${final}`;
    if (nodo.nodeValue !== traducido) nodo.nodeValue = traducido;
    registro.traducido = traducido;
  }

  function traducirAtributos(elemento) {
    ["placeholder", "title", "aria-label"].forEach((nombre) => {
      if (!elemento.hasAttribute(nombre)) return;
      let registros = sourceAttributes.get(elemento);
      if (!registros) { registros = {}; sourceAttributes.set(elemento, registros); }
      const actual = elemento.getAttribute(nombre);
      if (!registros[nombre] || actual !== registros[nombre].traducido) {
        registros[nombre] = { original: actual, traducido: actual };
      }
      const traducido = traducirCadena(registros[nombre].original);
      if (actual !== traducido) elemento.setAttribute(nombre, traducido);
      registros[nombre].traducido = traducido;
    });
  }

  function traducirArbol(raiz) {
    if (raiz.nodeType === Node.TEXT_NODE) { traducirNodoTexto(raiz); return; }
    if (raiz.nodeType !== Node.ELEMENT_NODE && raiz !== document) return;
    if (raiz.nodeType === Node.ELEMENT_NODE) traducirAtributos(raiz);
    const walker = document.createTreeWalker(raiz, NodeFilter.SHOW_TEXT, {
      acceptNode: (nodo) => nodo.parentElement?.closest("script, style, textarea") ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT
    });
    const nodos = [];
    while (walker.nextNode()) nodos.push(walker.currentNode);
    nodos.forEach(traducirNodoTexto);
    if (raiz.querySelectorAll) raiz.querySelectorAll("[placeholder], [title], [aria-label]").forEach(traducirAtributos);
  }

  function aplicarIdioma(idioma) {
    idiomaActual = ["es", "en", "he"].includes(idioma) ? idioma : "es";
    document.documentElement.lang = idiomaActual === "he" ? "he" : idiomaActual;
    document.documentElement.dir = idiomaActual === "he" ? "rtl" : "ltr";
    document.body.classList.toggle("idioma-he", idiomaActual === "he");
    if (idiomaSelect) idiomaSelect.value = idiomaActual;
    traducirArbol(document);
    try { localStorage.setItem(STORAGE_KEY, idiomaActual); } catch { /* preferencia opcional */ }
  }

  let idiomaGuardado = "es";
  try { idiomaGuardado = localStorage.getItem(STORAGE_KEY) || "es"; } catch { /* idioma predeterminado */ }
  idiomaSelect?.addEventListener("change", () => aplicarIdioma(idiomaSelect.value));
  aplicarIdioma(idiomaGuardado);

  const observer = new MutationObserver((cambios) => {
    cambios.forEach((cambio) => {
      if (cambio.type === "characterData") traducirNodoTexto(cambio.target);
      else cambio.addedNodes.forEach((nodo) => traducirArbol(nodo));
    });
  });
  observer.observe(document.body, { childList: true, subtree: true, characterData: true });
})();
