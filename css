/* Bloques añadidos: objetivo de alimentación y preferencia de dieta */
.preferencias-extra {
  margin-top: 24px;
  padding: 24px;
  background: var(--color-superficie);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-grande);
  box-shadow: 0 2px 8px rgb(20 32 25 / 4%);
}

.preferencias-extra__encabezado {
  margin-bottom: 18px;
}

.titulo-seccion--compacto {
  margin: 0 0 6px;
  font-size: 1.2rem;
}

.preferencias-extra .descripcion-seccion {
  margin: 0;
}

.objetivos-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.objetivo-opcion {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  width: 100%;
  padding: 16px;
  color: var(--color-texto);
  text-align: left;
  background: var(--color-superficie);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-medio);
  cursor: pointer;
  transition:
    border-color var(--transicion),
    background var(--transicion),
    box-shadow var(--transicion);
}

.objetivo-opcion:hover {
  border-color: var(--color-primario);
}

.objetivo-opcion:focus-visible {
  outline: 3px solid rgb(27 107 74 / 25%);
  outline-offset: 2px;
}

.objetivo-opcion[aria-pressed="true"] {
  border-color: var(--color-primario);
  background: var(--color-primario-suave);
  box-shadow: inset 0 0 0 1px var(--color-primario);
}

.objetivo-opcion__icono {
  display: grid;
  flex: 0 0 34px;
  width: 34px;
  height: 34px;
  place-items: center;
  color: var(--color-primario);
  background: var(--color-primario-suave);
  border-radius: 50%;
  font-weight: 700;
}

.objetivo-opcion__texto {
  display: grid;
  gap: 4px;
}

.objetivo-opcion__texto strong {
  font-family: var(--fuente-titulos);
  font-size: 0.95rem;
}

.objetivo-opcion__texto small {
  color: var(--color-texto-suave);
  line-height: 1.45;
}

.dieta-filtros {
  margin: 0 0 20px;
  padding: 0;
  border: 0;
}

.dieta-filtros__lista {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 10px;
}

.tabla-nutrimental-contenedor {
  overflow-x: auto;
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-medio);
}

.tabla-nutrimental {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.tabla-nutrimental caption {
  padding: 14px 16px;
  color: var(--color-texto-secundario);
  text-align: left;
  background: var(--color-superficie-alt);
  font-weight: 700;
}

.tabla-nutrimental th,
.tabla-nutrimental td {
  padding: 12px 16px;
  border-top: 1px solid var(--color-borde);
}

.tabla-nutrimental thead th {
  color: var(--color-texto-suave);
  font-size: 0.82rem;
  font-weight: 500;
}

.tabla-nutrimental tbody th {
  font-weight: 500;
}

.tabla-nutrimental tbody td {
  color: var(--color-primario);
  font-variant-numeric: tabular-nums;
  font-weight: 700;
}

@media (max-width: 720px) {
  .objetivos-grid {
    grid-template-columns: 1fr;
  }

  .preferencias-extra {
    padding: 18px;
  }
}
