/* ==========================================================================
   Sistema de animaciones táctiles y fluidas (sin saturación visual)
   Usa exclusivamente propiedades de compositor (transform, opacity) con
   curvas rápidas y naturales.
   ========================================================================== */
@keyframes barra-entrada {
  from { opacity: 0; transform: translateY(-6px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes elevacion-suave {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes dock-entrada {
  from { opacity: 0; transform: translate(-50%, 14px); }
  to { opacity: 1; transform: translate(-50%, 0); }
}

@keyframes dialogo-entrada {
  from { opacity: 0; transform: translateY(10px) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes fondo-dialogo {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes pulso-valor {
  0% { transform: scale(1); }
  40% { transform: scale(1.06); }
  100% { transform: scale(1); }
}

@keyframes burbuja-pop {
  0% { transform: scale(0.92); }
  60% { transform: scale(1.1); }
  100% { transform: scale(1.06); }
}

@keyframes check-pop {
  0% { transform: scale(0.985); }
  55% { transform: scale(1.015); }
  100% { transform: scale(1); }
}

@keyframes icono-pestana {
  0% { transform: translateY(0) scale(0.9); }
  55% { transform: translateY(-3px) scale(1.14); }
  100% { transform: translateY(-1px) scale(1.08); }
}

@keyframes brillo-barra {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

@keyframes motivo-flota {
  0% { transform: rotate(-12deg) translate(0, 0); }
  100% { transform: rotate(-9deg) translate(-5px, -6px); }
}

@keyframes aro-respira {
  0% { transform: scale(1); }
  100% { transform: scale(1.05); }
}

@keyframes pulso-tema {
  0% { transform: scale(0.99); }
  55% { transform: scale(1.01); }
  100% { transform: scale(1); }
}

/* Entradas iniciales limpias */
.barra-superior {
  animation: barra-entrada 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.panel-resumen .metrica {
  animation: elevacion-suave 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.panel-resumen .metrica:nth-child(2) { animation-delay: 35ms; }
.panel-resumen .metrica:nth-child(3) { animation-delay: 70ms; }
.panel-resumen .metrica:nth-child(4) { animation-delay: 105ms; }

.pestanas {
  animation: dock-entrada 320ms cubic-bezier(0.16, 1, 0.3, 1) 80ms both;
}

/* Tarjetas e ítems con entrada escalonada discreta */
.tarjeta-dia,
.tarjeta-tienda,
.item-despensa,
.tarjeta-receta-sugerida,
.asistente-columna,
.panel-sustitutos {
  animation: elevacion-suave 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.tarjeta-dia:nth-child(2),
.tarjeta-tienda:nth-child(2),
.item-despensa:nth-child(2),
.tarjeta-receta-sugerida:nth-child(2),
.asistente-columna:nth-child(2) { animation-delay: 30ms; }

.tarjeta-dia:nth-child(3),
.tarjeta-tienda:nth-child(3),
.item-despensa:nth-child(3),
.tarjeta-receta-sugerida:nth-child(3),
.asistente-columna:nth-child(3) { animation-delay: 60ms; }

.tarjeta-dia:nth-child(4),
.tarjeta-tienda:nth-child(4),
.item-despensa:nth-child(4),
.tarjeta-receta-sugerida:nth-child(4) { animation-delay: 90ms; }

.tarjeta-dia:nth-child(5),
.item-despensa:nth-child(5),
.tarjeta-receta-sugerida:nth-child(5) { animation-delay: 120ms; }

.tarjeta-dia:nth-child(n + 6),
.item-despensa:nth-child(n + 6),
.tarjeta-receta-sugerida:nth-child(n + 6) { animation-delay: 150ms; }

/* Micro-interacciones táctiles */
.boton {
  position: relative;
  overflow: hidden;
}

.boton:active,
.boton-opcion:active,
.boton-icono:active,
.burbuja-personas:active,
.objetivo-opcion:active {
  transform: scale(0.97);
}

.boton--primario::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(110deg, transparent 25%, rgb(255 255 255 / 22%) 50%, transparent 75%);
  opacity: 0;
  transform: translateX(-120%);
  transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1), opacity 180ms ease;
  pointer-events: none;
}

.boton--primario:hover::before {
  opacity: 1;
  transform: translateX(120%);
}

/* #btn-generar-header usa overflow: visible para su aura al hacer clic;
   evitamos el destello horizontal ::before para que no sobresalga del botón. */
#btn-generar-header::before {
  display: none;
}

.boton-opcion {
  transition: transform 150ms cubic-bezier(0.16, 1, 0.3, 1), background-color var(--transicion), border-color var(--transicion), color var(--transicion);
}

.boton-opcion:hover {
  transform: translateY(-1px);
}

.boton-opcion.seleccionado {
  animation: check-pop 200ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.check-caja {
  transition: transform 150ms cubic-bezier(0.16, 1, 0.3, 1), border-color var(--transicion), background-color var(--transicion);
}

.check-caja:hover {
  transform: translateY(-1px);
}

.check-caja:has(input:checked) {
  border-color: var(--color-primario);
  background-color: var(--color-primario-suave);
  animation: check-pop 200ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.item-compra {
  transition: transform 150ms cubic-bezier(0.16, 1, 0.3, 1), opacity 180ms ease;
}

.item-compra:hover {
  transform: translateX(3px);
}

.item-compra--comprado {
  opacity: 0.78;
}

.burbuja-personas.activa {
  animation: burbuja-pop 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.objetivo-opcion__icono {
  transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
}

.objetivo-opcion:hover .objetivo-opcion__icono,
.objetivo-opcion[aria-pressed="true"] .objetivo-opcion__icono {
  transform: scale(1.1);
}

.tarjeta-receta-sugerida,
.asistente-columna {
  transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1), border-color 180ms ease;
}

.tarjeta-receta-sugerida:hover,
.asistente-columna:hover {
  transform: translateY(-2px);
  border-color: var(--color-primario);
}

.tabla-nutrimental tbody tr {
  transition: background-color 150ms ease;
}

.tabla-nutrimental tbody tr:hover {
  background-color: var(--color-primario-suave);
}

/* Barra de progreso viva pero tranquila */
.barra-progreso__relleno {
  animation: brillo-barra 5.5s linear infinite;
}

/* Pulso breve al actualizar métricas o cambiar de tema */
.metrica__valor {
  display: inline-block;
  transform-origin: left center;
}

.metrica__valor.valor-actualizado {
  animation: pulso-valor 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.config-dialog__panel.tema-cambiado {
  animation: pulso-tema 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

/* Diálogos y modales con entrada fluida */
.config-dialog[open] .config-dialog__panel,
.modal[open] .modal__contenido {
  animation: dialogo-entrada 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.config-dialog[open]::backdrop,
.modal[open]::backdrop {
  animation: fondo-dialogo 180ms ease-out both;
}

/* Rebote sutil en el icono de la pestaña activa */
.pestana.activa .pestana__icono {
  animation: icono-pestana 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

/* Movimiento ambiental muy lento en los motivos decorativos */
.slider-vistas > .seccion-vista::before {
  animation: motivo-flota 14s ease-in-out infinite alternate;
}

.slider-vistas > .seccion-vista::after {
  animation: aro-respira 16s ease-in-out infinite alternate;
}

/* Notificación con rebote suave */
.notificacion {
  transform: translateY(12px) scale(0.96);
}

.notificacion.visible {
  transform: translateY(0) scale(1);
}

/* ==========================================================================
   Liquid Glass (estilo iOS) para todos los elementos flotantes
   Barra superior, panel de presupuesto pegajoso, dock inferior de navegación,
   modales, notificaciones y burbuja flotante de confirmación.
   ========================================================================== */
:root {
  --glass-bg: color-mix(in srgb, var(--color-superficie) 56%, transparent);
  --glass-bg-fuerte: color-mix(in srgb, var(--color-superficie) 72%, transparent);
  --glass-sub: color-mix(in srgb, var(--color-superficie-alt) 52%, transparent);
  --glass-sheen: linear-gradient(
    135deg,
    rgb(255 255 255 / 62%) 0%,
    rgb(255 255 255 / 20%) 35%,
    rgb(255 255 255 / 4%) 62%,
    rgb(255 255 255 / 28%) 100%
  );
  --glass-borde: color-mix(in srgb, #ffffff 68%, var(--color-borde));
  --glass-borde-sutil: color-mix(in srgb, #ffffff 48%, var(--color-borde));
  --glass-sombra:
    0 14px 38px rgb(0 0 0 / 16%),
    0 2px 8px rgb(0 0 0 / 8%),
    inset 0 1.5px 1px rgb(255 255 255 / 82%),
    inset 0 -1px 1px color-mix(in srgb, var(--color-primario) 18%, transparent);
  --glass-blur: blur(24px) saturate(190%) brightness(1.04);
  --glass-blur-modal: blur(28px) saturate(195%) brightness(1.03);
}

body.modo-oscuro {
  --glass-bg: color-mix(in srgb, var(--color-superficie) 54%, transparent);
  --glass-bg-fuerte: color-mix(in srgb, var(--color-superficie) 70%, transparent);
  --glass-sub: color-mix(in srgb, var(--color-superficie-alt) 56%, transparent);
  --glass-sheen: linear-gradient(
    135deg,
    rgb(255 255 255 / 22%) 0%,
    rgb(255 255 255 / 6%) 38%,
    rgb(255 255 255 / 0%) 64%,
    rgb(255 255 255 / 11%) 100%
  );
  --glass-borde: color-mix(in srgb, #ffffff 24%, var(--color-borde));
  --glass-borde-sutil: color-mix(in srgb, #ffffff 16%, var(--color-borde));
  --glass-sombra:
    0 18px 46px rgb(0 0 0 / 54%),
    0 2px 10px rgb(0 0 0 / 32%),
    inset 0 1px 1px rgb(255 255 255 / 26%),
    inset 0 -1px 1px rgb(255 255 255 / 8%);
  --glass-blur: blur(24px) saturate(185%) brightness(1.08);
  --glass-blur-modal: blur(30px) saturate(190%) brightness(1.06);
}

/* 1. Barra superior flotante (sticky) */
.barra-superior {
  background: var(--glass-sheen), var(--glass-bg);
  border-bottom: 1px solid var(--glass-borde);
  box-shadow:
    0 8px 26px rgb(0 0 0 / 10%),
    inset 0 -1px 0 rgb(255 255 255 / 45%);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
}

body.modo-oscuro .barra-superior {
  box-shadow:
    0 10px 30px rgb(0 0 0 / 42%),
    inset 0 -1px 0 rgb(255 255 255 / 14%);
}

/* Botón circular de configuración con acabado cristalino */
.boton-configuracion,
.boton-configuracion__cerrar,
.boton-cerrar {
  background: var(--glass-sheen), var(--glass-sub);
  border: 1px solid var(--glass-borde);
  box-shadow:
    0 4px 14px rgb(0 0 0 / 10%),
    inset 0 1px 1px rgb(255 255 255 / 65%);
  backdrop-filter: blur(14px) saturate(170%);
  -webkit-backdrop-filter: blur(14px) saturate(170%);
}

body.modo-oscuro .boton-configuracion,
body.modo-oscuro .boton-configuracion__cerrar,
body.modo-oscuro .boton-cerrar {
  box-shadow:
    0 6px 16px rgb(0 0 0 / 36%),
    inset 0 1px 1px rgb(255 255 255 / 24%);
}

/* 2. Panel de presupuesto pegajoso (sticky) */
.panel-resumen {
  background: var(--glass-sheen), var(--glass-bg-fuerte);
  border: 1px solid var(--glass-borde);
  box-shadow: var(--glass-sombra);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
}

/* 3. Navegación inferior flotante (Dock Liquid Glass estilo iOS) */
.pestanas {
  padding: 6px 7px;
  border: 1px solid var(--glass-borde);
  border-radius: 999px;
  background: var(--glass-sheen), var(--glass-bg);
  box-shadow:
    0 16px 42px rgb(0 0 0 / 22%),
    0 3px 10px rgb(0 0 0 / 10%),
    inset 0 1.5px 1.5px rgb(255 255 255 / 86%),
    inset 0 -1.5px 2px color-mix(in srgb, var(--color-primario) 18%, transparent);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
}

body.modo-oscuro .pestanas {
  box-shadow:
    0 18px 48px rgb(0 0 0 / 58%),
    0 4px 12px rgb(0 0 0 / 35%),
    inset 0 1px 1.5px rgb(255 255 255 / 30%),
    inset 0 -1px 2px rgb(255 255 255 / 8%);
}

.pestana {
  border-radius: 999px;
  border: 1px solid transparent;
}

.pestana:hover {
  background: rgb(255 255 255 / 36%);
  border-color: rgb(255 255 255 / 55%);
  box-shadow: inset 0 1px 1px rgb(255 255 255 / 60%);
}

body.modo-oscuro .pestana:hover {
  background: rgb(255 255 255 / 12%);
  border-color: rgb(255 255 255 / 18%);
  box-shadow: inset 0 1px 1px rgb(255 255 255 / 18%);
}

/* Cápsula activa con brillo líquido */
.pestana.activa {
  color: #ffffff;
  background:
    linear-gradient(
      180deg,
      rgb(255 255 255 / 26%) 0%,
      rgb(255 255 255 / 0%) 55%,
      rgb(0 0 0 / 10%) 100%
    ),
    color-mix(in srgb, var(--color-primario) 86%, transparent);
  border-color: color-mix(in srgb, #ffffff 42%, var(--color-primario));
  box-shadow:
    0 6px 18px color-mix(in srgb, var(--color-primario) 44%, transparent),
    inset 0 1.5px 1px rgb(255 255 255 / 50%),
    inset 0 -1px 1px rgb(0 0 0 / 18%);
}

/* 4. Modales flotantes (Receta y Configuración) */
.modal {
  border: 0;
  background: transparent;
  box-shadow: none;
  overflow: visible;
}

.modal::backdrop,
.config-dialog::backdrop {
  background: rgb(6 14 10 / 42%);
  backdrop-filter: blur(10px) saturate(140%);
  -webkit-backdrop-filter: blur(10px) saturate(140%);
}

.modal__contenido,
.config-dialog__panel {
  border: 1px solid var(--glass-borde);
  border-radius: var(--radio-grande);
  background: var(--glass-sheen), var(--glass-bg-fuerte);
  box-shadow: var(--glass-sombra);
  backdrop-filter: var(--glass-blur-modal);
  -webkit-backdrop-filter: var(--glass-blur-modal);
}

.modo-oscuro-control,
.selector-idioma {
  background: var(--glass-sub);
  border: 1px solid var(--glass-borde-sutil);
  box-shadow: inset 0 1px 1px rgb(255 255 255 / 45%);
}

body.modo-oscuro .modo-oscuro-control,
body.modo-oscuro .selector-idioma {
  box-shadow: inset 0 1px 1px rgb(255 255 255 / 14%);
}

/* 5. Notificación flotante (Toast Liquid Glass con alto contraste) */
.notificacion {
  border: 1px solid color-mix(in srgb, #ffffff 34%, var(--color-primario));
  border-radius: 18px;
  background:
    linear-gradient(
      135deg,
      rgb(255 255 255 / 22%) 0%,
      rgb(255 255 255 / 4%) 45%,
      rgb(255 255 255 / 12%) 100%
    ),
    color-mix(in srgb, var(--color-texto) 78%, transparent);
  color: #ffffff;
  box-shadow:
    0 14px 36px rgb(0 0 0 / 28%),
    inset 0 1px 1px rgb(255 255 255 / 38%);
  backdrop-filter: blur(22px) saturate(190%);
  -webkit-backdrop-filter: blur(22px) saturate(190%);
}

body.modo-oscuro .notificacion {
  border: 1px solid color-mix(in srgb, var(--color-primario) 78%, #ffffff);
  background:
    linear-gradient(
      135deg,
      rgb(255 255 255 / 20%) 0%,
      rgb(255 255 255 / 4%) 45%,
      rgb(255 255 255 / 10%) 100%
    ),
    color-mix(in srgb, var(--color-superficie-alt) 76%, transparent);
  color: var(--color-texto);
  box-shadow:
    0 16px 40px rgb(0 0 0 / 58%),
    inset 0 1px 1px rgb(255 255 255 / 28%);
}

/* 6. Burbuja flotante de confirmación (palomita) */
.animacion-paloma {
  background:
    linear-gradient(135deg, rgb(255 255 255 / 65%), rgb(255 255 255 / 12%)),
    color-mix(in srgb, var(--color-primario-suave) 72%, transparent);
  border: 1px solid color-mix(in srgb, #ffffff 55%, var(--color-primario));
  box-shadow:
    0 8px 22px rgb(0 0 0 / 18%),
    inset 0 1px 1px rgb(255 255 255 / 78%);
  backdrop-filter: blur(12px) saturate(180%);
  -webkit-backdrop-filter: blur(12px) saturate(180%);
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
