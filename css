/* ==========================================================================
   Planeador de Comida y Despensa — Estilos puros en CSS
   Sistema de diseño responsivo con temas completos medio sólidos y vibrantes
   para mejorar la visibilidad en toda la página (fondos, cajas y apartados).
   ========================================================================== */

:root {
  /* Variables base (tema Esmeralda vibrante por defecto) */
  --color-fondo: #8fdcb2;
  --color-fondo-acento: #65cb96;
  --color-seccion: #c5f0d8;
  --color-seccion-grad: #a8e4c2;
  --color-superficie: #e4faee;
  --color-superficie-alt: #b3e8cb;
  --color-barra: rgb(210 245 225 / 92%);
  --color-borde: #4fb380;
  --color-borde-fuerte: #2d9360;
  --color-sombra: rgb(9 54 31 / 14%);

  /* Tipografía de alto contraste */
  --color-texto: #072215;
  --color-texto-secundario: #13422b;
  --color-texto-suave: #1e573b;

  /* Acento principal */
  --color-primario: #0b7040;
  --color-primario-hover: #075430;
  --color-primario-suave: #9ce0bc;
  --color-primario-brillo: #26a868;

  /* Colores semánticos */
  --color-exito: #0d6839;
  --color-exito-fondo: #c2f0d5;
  --color-aviso: #8f4a00;
  --color-aviso-fondo: #fde4b8;
  --color-peligro: #a61b1b;
  --color-peligro-fondo: #fcd4d4;

  /* Fuentes */
  --fuente-titulos: "Plus Jakarta Sans", system-ui, -apple-system, sans-serif;
  --fuente-cuerpo: "DM Sans", system-ui, -apple-system, sans-serif;

  /* Radios y espaciado */
  --radio-chico: 12px;
  --radio-medio: 18px;
  --radio-grande: 24px;
  --transicion: 160ms cubic-bezier(0.16, 1, 0.3, 1);
}

/* Reinicio básico */
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 148px;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: var(--fuente-cuerpo);
  font-size: 15px;
  line-height: 1.55;
  color: var(--color-texto);
  background:
    radial-gradient(ellipse at 88% 3%, color-mix(in srgb, var(--color-fondo-acento) 75%, transparent), transparent 32rem),
    radial-gradient(ellipse at 4% 42%, color-mix(in srgb, var(--color-seccion) 65%, transparent), transparent 28rem),
    var(--color-fondo);
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3, h4 {
  margin: 0;
  font-family: var(--fuente-titulos);
  font-weight: 700;
  line-height: 1.25;
  color: var(--color-texto);
  text-wrap: balance;
}

p {
  margin: 0;
}

button,
input,
select {
  font-family: inherit;
  font-size: inherit;
}

:focus-visible {
  outline: 2px solid var(--color-primario);
  outline-offset: 2px;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.oculto {
  display: none !important;
}

.numero {
  font-variant-numeric: tabular-nums;
}

/* Contenedor principal */
.contenedor {
  width: 100%;
  max-width: 1180px;
  margin-inline: auto;
  padding-inline: 20px;
}

/* ==========================================================================
   Barra superior
   ========================================================================== */
.barra-superior {
  position: sticky;
  top: 0;
  z-index: 30;
  background: var(--color-barra);
  border-bottom: 2px solid var(--color-borde);
  backdrop-filter: saturate(170%) blur(16px);
  -webkit-backdrop-filter: saturate(170%) blur(16px);
}

.barra-superior__interior {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  width: min(100%, 960px);
  min-height: 62px;
  padding-inline: 22px;
  margin-inline: auto;
}

.marca {
  font-family: var(--fuente-titulos);
  font-size: 1.15rem;
  font-weight: 700;
  letter-spacing: -0.045em;
  color: var(--color-texto);
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
}

.marca__punto {
  color: var(--color-primario);
}

.navegacion {
  display: none !important;
}

.barra-superior .boton {
  min-height: 40px;
  padding-inline: 18px;
  border-radius: 999px;
}

/* ==========================================================================
   Botones
   ========================================================================== */
.boton {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 40px;
  padding: 9px 18px;
  border-radius: 13px;
  border: 1.5px solid transparent;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  flex-shrink: 0;
  transition: background-color var(--transicion), border-color var(--transicion), color var(--transicion), transform var(--transicion), box-shadow var(--transicion);
}

.boton:active {
  transform: translateY(1px);
}

.boton--primario {
  background-color: var(--color-primario);
  color: #ffffff;
  box-shadow: 0 5px 14px var(--color-sombra);
}

.boton--primario:hover {
  background-color: var(--color-primario-hover);
  transform: translateY(-1px);
}

.boton--secundario {
  background-color: var(--color-superficie-alt);
  color: var(--color-texto);
  border-color: var(--color-borde-fuerte);
}

.boton--secundario:hover {
  background-color: var(--color-primario-suave);
  border-color: var(--color-primario);
}

.boton--texto {
  background-color: transparent;
  color: var(--color-texto-secundario);
  padding-inline: 10px;
}

.boton--texto:hover {
  color: var(--color-texto);
  background-color: var(--color-superficie-alt);
}

.boton--chico {
  min-height: 34px;
  padding: 6px 12px;
  font-size: 0.82rem;
}

/* ==========================================================================
   Contenido principal y Panel de presupuesto
   ========================================================================== */
.contenedor.contenido-principal {
  max-width: 960px;
  padding: 24px 22px calc(112px + env(safe-area-inset-bottom));
}

.panel-resumen {
  position: sticky;
  top: 68px;
  z-index: 28;
  margin-bottom: 18px;
  padding: 20px 24px;
  border: 2px solid var(--color-borde-fuerte);
  border-radius: 26px;
  background: linear-gradient(145deg, var(--color-superficie) 20%, var(--color-seccion));
  box-shadow: 0 12px 30px var(--color-sombra);
  transition: padding 220ms ease, border-radius 220ms ease, box-shadow 220ms ease, transform 220ms ease, background-color 180ms ease, border-color 180ms ease;
}

.panel-resumen__metricas {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 14px;
}

.metrica {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 2px 0;
}

.metrica__etiqueta {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--color-texto-suave);
  letter-spacing: 0.01em;
}

.metrica__valor {
  font-family: var(--fuente-titulos);
  font-size: 1.35rem;
  font-weight: 700;
  letter-spacing: -0.04em;
  color: var(--color-texto);
}

.metrica__valor--exito {
  color: var(--color-exito);
}

.metrica__valor--peligro {
  color: var(--color-peligro);
}

.barra-progreso-contenedor {
  width: 100%;
  height: 10px;
  background-color: var(--color-superficie-alt);
  border: 1px solid var(--color-borde);
  border-radius: 999px;
  overflow: hidden;
  margin-bottom: 6px;
}

.barra-progreso__relleno {
  height: 100%;
  width: 0%;
  background-color: var(--color-primario);
  background-image: linear-gradient(90deg, var(--color-primario), var(--color-primario-brillo), var(--color-primario));
  background-size: 200% 100%;
  border-radius: 999px;
  transition: width 260ms ease, background-color 200ms ease;
}

.barra-progreso__relleno--aviso {
  background-color: var(--color-aviso);
  background-image: none;
}

.barra-progreso__relleno--peligro {
  background-color: var(--color-peligro);
  background-image: none;
}

.alerta-presupuesto {
  font-size: 0.9rem;
  padding: 10px 14px;
  border-radius: 14px;
  background-color: var(--color-superficie-alt);
  color: var(--color-texto-secundario);
}

.alerta-presupuesto--exito {
  background-color: var(--color-exito-fondo);
  color: var(--color-exito);
}

.alerta-presupuesto--aviso {
  background-color: var(--color-aviso-fondo);
  color: var(--color-aviso);
}

.alerta-presupuesto--peligro {
  background-color: var(--color-peligro-fondo);
  color: var(--color-peligro);
  font-weight: 600;
}

/* ==========================================================================
   Carrusel horizontal de secciones y barra inferior de navegación
   ========================================================================== */
.slider-vistas {
  display: flex;
  width: 100%;
  gap: 0;
  overflow-x: auto;
  overscroll-behavior-x: contain;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
  touch-action: pan-x pan-y;
}

.slider-vistas::-webkit-scrollbar {
  display: none;
}

.slider-vistas > .seccion-vista {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  display: block !important;
  flex: 0 0 100%;
  width: 100%;
  min-width: 100%;
  margin-top: 18px;
  padding: 24px;
  background: linear-gradient(150deg, var(--color-seccion), var(--color-seccion-grad));
  border: 2px solid var(--color-borde-fuerte);
  border-radius: 26px;
  box-shadow: 0 12px 32px var(--color-sombra);
  scroll-snap-align: start;
  scroll-snap-stop: always;
}

.slider-vistas > .seccion-vista > * {
  position: relative;
  z-index: 1;
}

.slider-vistas > .seccion-vista::before {
  position: absolute;
  z-index: 0;
  right: 14px;
  bottom: 8px;
  color: var(--color-primario);
  content: var(--doodle, "✧");
  font-family: Georgia, serif;
  font-size: clamp(4rem, 15vw, 7rem);
  line-height: 1;
  opacity: 0.14;
  transform: rotate(-12deg);
  pointer-events: none;
}

.slider-vistas > .seccion-vista::after {
  position: absolute;
  z-index: 0;
  top: -62px;
  right: -46px;
  width: 180px;
  height: 180px;
  border: 2px solid var(--color-primario);
  border-radius: 50%;
  content: "";
  opacity: 0.14;
  pointer-events: none;
}

#seccion-familia { --doodle: "✿"; }
#seccion-menu { --doodle: "✳"; }
#seccion-compras { --doodle: "⌁"; }
#seccion-despensa { --doodle: "❋"; }
#seccion-asistente { --doodle: "✦"; }

.pestanas {
  position: fixed;
  left: 50%;
  bottom: max(10px, env(safe-area-inset-bottom));
  z-index: 60;
  display: flex !important;
  width: min(520px, calc(100% - 24px));
  min-height: 66px;
  gap: 4px;
  margin: 0;
  padding: 7px 8px;
  transform: translateX(-50%);
  overflow: visible;
  border: 2px solid var(--color-borde-fuerte);
  border-radius: 22px;
  background: var(--color-barra);
  box-shadow: 0 12px 36px var(--color-sombra);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
}

.pestana {
  display: flex;
  flex: 1 1 20%;
  min-width: 0;
  min-height: 50px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1px;
  padding: 4px 2px;
  border: 1.5px solid transparent;
  border-radius: 15px;
  background: transparent;
  color: var(--color-texto-secundario);
  font-size: 0.68rem;
  font-weight: 700;
  line-height: 1.15;
  white-space: nowrap;
  cursor: pointer;
  transition: color 180ms ease, background 180ms ease, border-color 180ms ease, transform 180ms ease;
}

.pestana:hover {
  color: var(--color-texto);
  background: var(--color-superficie-alt);
}

.pestana__icono {
  display: block;
  font-family: system-ui, sans-serif;
  font-size: 1.28rem;
  line-height: 1.2;
  transition: transform 180ms ease;
}

.pestana.activa {
  color: #ffffff;
  background: var(--color-primario);
  border-color: var(--color-primario-hover);
  box-shadow: 0 4px 12px var(--color-sombra);
}

.pestana.activa .pestana__icono {
  transform: translateY(-1px) scale(1.08);
}

.pestana:active {
  transform: scale(0.96);
}

/* ==========================================================================
   Encabezados de sección
   ========================================================================== */
.encabezado-seccion {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
  flex-wrap: wrap;
}

.titulo-seccion {
  font-size: clamp(1.3rem, 4vw, 1.65rem);
  letter-spacing: -0.035em;
  margin-bottom: 6px;
}

.descripcion-seccion {
  color: var(--color-texto-secundario);
  max-width: 64ch;
  font-size: 0.94rem;
}

.acciones-seccion {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

/* ==========================================================================
   Sección 1: Formulario de familia y presupuesto
   ========================================================================== */
.formulario-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  background-color: var(--color-superficie);
  border: 2px solid var(--color-borde);
  border-radius: 20px;
  padding: 22px;
  box-shadow: 0 6px 18px var(--color-sombra);
}

.bloque-campo {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.bloque-campo--completo {
  grid-column: 1 / -1;
}

.etiqueta-campo {
  font-weight: 700;
  font-size: 0.92rem;
  color: var(--color-texto);
}

.etiqueta-secundaria {
  font-size: 0.84rem;
  font-weight: 600;
  color: var(--color-texto-secundario);
  margin-top: 8px;
}

.ayuda-campo {
  font-size: 0.82rem;
  color: var(--color-texto-suave);
}

input[type="text"],
input[type="number"],
input[type="date"],
select,
textarea {
  width: 100%;
  min-height: 46px;
  padding: 11px 14px;
  border: 1.5px solid var(--color-borde-fuerte);
  border-radius: 13px;
  background-color: var(--color-superficie-alt);
  color: var(--color-texto);
  font-weight: 500;
  transition: border-color var(--transicion), box-shadow var(--transicion), background-color var(--transicion);
}

input::placeholder,
textarea::placeholder {
  color: var(--color-texto-suave);
  opacity: 0.85;
}

input[type="text"]:focus,
input[type="number"]:focus,
input[type="date"]:focus,
select:focus,
textarea:focus {
  border-color: var(--color-primario);
  background-color: var(--color-superficie);
  box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-primario) 22%, transparent);
  outline: 0;
}

.campo-prefijo {
  display: flex;
  align-items: center;
  border: 1.5px solid var(--color-borde-fuerte);
  border-radius: 13px;
  background-color: var(--color-superficie-alt);
  overflow: hidden;
}

.campo-prefijo:focus-within {
  border-color: var(--color-primario);
  box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-primario) 22%, transparent);
}

.campo-prefijo input {
  border: none;
  min-height: 44px;
  background-color: transparent;
}

.campo-prefijo input:focus {
  box-shadow: none;
}

.campo-prefijo__simbolo,
.campo-prefijo__sufijo {
  padding-inline: 12px;
  font-size: 0.86rem;
  font-weight: 700;
  color: var(--color-texto);
  background-color: var(--color-primario-suave);
  align-self: stretch;
  display: flex;
  align-items: center;
}

.opciones-rapidas {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 4px;
}

.boton-opcion {
  min-height: 36px;
  padding: 6px 13px;
  border: 1.5px solid var(--color-borde-fuerte);
  border-radius: 10px;
  background-color: var(--color-superficie-alt);
  color: var(--color-texto);
  font-size: 0.84rem;
  font-weight: 600;
  cursor: pointer;
  transition: background-color var(--transicion), border-color var(--transicion), color var(--transicion);
}

.boton-opcion:hover {
  border-color: var(--color-primario);
  background-color: var(--color-primario-suave);
}

.boton-opcion.seleccionado {
  background-color: var(--color-primario);
  border-color: var(--color-primario-hover);
  color: #ffffff;
  font-weight: 700;
}

.grupo-opciones {
  border: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.rejilla-checks {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
  gap: 10px;
}

.check-caja {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 42px;
  padding: 8px 12px;
  border: 1.5px solid var(--color-borde);
  border-radius: 11px;
  background-color: var(--color-superficie-alt);
  color: var(--color-texto);
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  transition: border-color var(--transicion), background-color var(--transicion);
}

.check-caja:hover {
  background-color: var(--color-primario-suave);
  border-color: var(--color-primario);
}

.check-caja input[type="checkbox"] {
  width: 18px;
  height: 18px;
  accent-color: var(--color-primario);
  cursor: pointer;
}

.agregar-tienda-fila {
  display: flex;
  gap: 10px;
  margin-top: 4px;
}

.acciones-formulario {
  display: flex;
  align-items: center;
  gap: 14px;
  padding-top: 12px;
  border-top: 1.5px solid var(--color-borde);
  flex-wrap: wrap;
}

/* ==========================================================================
   Sección 2: Menú semanal
   ========================================================================== */
.panel-sustitutos {
  background-color: var(--color-aviso-fondo);
  border: 2px solid var(--color-aviso);
  border-radius: var(--radio-medio);
  padding: 16px 20px;
  margin-bottom: 20px;
}

.panel-sustitutos__titulo {
  font-size: 0.96rem;
  color: var(--color-aviso);
  margin-bottom: 10px;
}

.lista-sustitutos {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.item-sustituto {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding-top: 10px;
  border-top: 1px solid color-mix(in srgb, var(--color-aviso) 28%, transparent);
  flex-wrap: wrap;
}

.item-sustituto:first-child {
  padding-top: 0;
  border-top: none;
}

.item-sustituto__texto {
  font-size: 0.9rem;
  color: var(--color-texto);
}

.item-sustituto__ahorro {
  font-size: 0.84rem;
  color: var(--color-exito);
  font-weight: 700;
}

.grid-menu {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  gap: 16px;
}

.tarjeta-dia {
  background-color: var(--color-superficie);
  border: 2px solid var(--color-borde);
  border-radius: 18px;
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  box-shadow: 0 6px 18px var(--color-sombra);
  transition: transform 160ms ease-out, border-color 160ms ease, background-color 180ms ease;
}

.tarjeta-dia:hover {
  transform: translateY(-2px);
  border-color: var(--color-primario);
}

.tarjeta-dia__cabecera {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 10px;
  border-bottom: 1.5px solid var(--color-borde);
}

.tarjeta-dia__nombre {
  font-size: 1.05rem;
}

.tarjeta-dia__total {
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--color-primario);
}

.comida-bloque {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--color-superficie-alt);
}

.comida-bloque:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.comida-bloque__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--color-texto-suave);
}

.comida-bloque__fila {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}

.comida-bloque__titulo {
  font-weight: 700;
  font-size: 0.96rem;
  color: var(--color-texto);
  background: none;
  border: none;
  padding: 0;
  text-align: left;
  cursor: pointer;
}

.comida-bloque__titulo:hover {
  color: var(--color-primario);
  text-decoration: underline;
}

.comida-bloque__acciones {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.boton-icono {
  min-width: 34px;
  min-height: 34px;
  padding: 4px 10px;
  border: 1.5px solid var(--color-borde-fuerte);
  border-radius: 9px;
  background-color: var(--color-superficie-alt);
  color: var(--color-texto);
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  transition: background-color var(--transicion), color var(--transicion), border-color var(--transicion);
}

.boton-icono:hover {
  background-color: var(--color-primario);
  border-color: var(--color-primario-hover);
  color: #ffffff;
}

/* ==========================================================================
   Sección 3: Lista de compras por tienda
   ========================================================================== */
.resumen-compras-barra {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  background-color: var(--color-superficie);
  border: 2px solid var(--color-borde);
  border-radius: var(--radio-medio);
  padding: 14px 18px;
  margin-bottom: 20px;
  font-size: 0.92rem;
  color: var(--color-texto-secundario);
}

.resumen-compras-barra strong {
  color: var(--color-texto);
}

.grid-tiendas {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  gap: 16px;
}

.tarjeta-tienda {
  background-color: var(--color-superficie);
  border: 2px solid var(--color-borde);
  border-radius: 18px;
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-shadow: 0 6px 18px var(--color-sombra);
  transition: transform 160ms ease-out, border-color 160ms ease, background-color 180ms ease;
}

.tarjeta-tienda:hover {
  transform: translateY(-2px);
  border-color: var(--color-primario);
}

.tarjeta-tienda__cabecera {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 10px;
  border-bottom: 1.5px solid var(--color-borde);
}

.tarjeta-tienda__nombre {
  font-size: 1.05rem;
}

.tarjeta-tienda__subtotal {
  font-weight: 700;
  font-size: 0.94rem;
  color: var(--color-primario);
}

.lista-ingredientes {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
}

.item-compra {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-block: 10px;
  border-bottom: 1px solid var(--color-borde);
}

.item-compra:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.item-compra__label {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  cursor: pointer;
  flex: 1;
}

.item-compra__label input[type="checkbox"] {
  width: 18px;
  height: 18px;
  margin-top: 2px;
  accent-color: var(--color-primario);
  cursor: pointer;
  flex-shrink: 0;
}

.item-compra__nombre {
  display: block;
  font-weight: 600;
  color: var(--color-texto);
}

.item-compra__cantidad {
  display: block;
  font-size: 0.82rem;
  color: var(--color-texto-suave);
}

.item-compra__precio {
  font-weight: 700;
  font-size: 0.88rem;
  color: var(--color-texto-secundario);
  white-space: nowrap;
}

.item-compra--comprado .item-compra__nombre {
  text-decoration: line-through;
  color: var(--color-texto-suave);
}

.item-compra--comprado .item-compra__precio {
  color: var(--color-exito);
}

/* ==========================================================================
   Sección 4: Despensa y recetas por caducidad
   ========================================================================== */
.layout-despensa {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
  gap: 20px;
  align-items: start;
}

.panel-despensa,
.panel-recetas-despensa {
  background-color: var(--color-superficie);
  border: 2px solid var(--color-borde);
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 6px 18px var(--color-sombra);
}

.subtitulo-bloque {
  font-size: 1.12rem;
  margin-bottom: 6px;
}

.texto-ayuda-suave {
  font-size: 0.86rem;
  color: var(--color-texto-suave);
  margin-bottom: 16px;
}

.formulario-despensa {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-bottom: 18px;
  margin-bottom: 16px;
  border-bottom: 1.5px solid var(--color-borde);
}

.fila-despensa-inputs {
  display: grid;
  grid-template-columns: 1.4fr 0.8fr 1fr;
  gap: 10px;
}

.campo-compacto {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.etiqueta-pequena {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--color-texto-secundario);
}

.lista-despensa {
  display: flex;
  flex-direction: column;
}

.item-despensa {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-block: 11px;
  border-bottom: 1px solid var(--color-borde);
}

.item-despensa:last-child {
  border-bottom: none;
}

.item-despensa__info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.item-despensa__nombre {
  font-weight: 700;
  font-size: 0.94rem;
}

.item-despensa__meta {
  font-size: 0.82rem;
  color: var(--color-texto-suave);
}

.caducidad-urgente {
  color: var(--color-peligro);
  font-weight: 700;
}

.caducidad-pronto {
  color: var(--color-aviso);
  font-weight: 700;
}

.caducidad-normal {
  color: var(--color-exito);
  font-weight: 600;
}

.lista-recetas-sugeridas {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.tarjeta-receta-sugerida {
  padding: 14px;
  background-color: var(--color-superficie-alt);
  border: 1.5px solid var(--color-borde);
  border-radius: 14px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.tarjeta-receta-sugerida__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
}

.tarjeta-receta-sugerida__nombre {
  font-size: 1rem;
  font-weight: 700;
}

.tarjeta-receta-sugerida__meta {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--color-texto-suave);
}

.tarjeta-receta-sugerida__detalle {
  font-size: 0.88rem;
  color: var(--color-texto-secundario);
}

.aviso-aprovecha {
  font-size: 0.83rem;
  color: var(--color-peligro);
  font-weight: 700;
}

/* ==========================================================================
   Sección 5: Asistente virtual
   ========================================================================== */
.bloque-asistente {
  background-color: var(--color-superficie);
  border: 2px solid var(--color-borde);
  border-radius: 20px;
  padding: 24px;
  box-shadow: 0 6px 18px var(--color-sombra);
}

.encabezado-asistente {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}

.resultado-asistente {
  border-top: 1.5px solid var(--color-borde);
  padding-top: 18px;
}

.asistente-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
  margin-top: 14px;
}

.asistente-columna {
  padding: 14px;
  background-color: var(--color-superficie-alt);
  border: 1.5px solid var(--color-borde);
  border-radius: 14px;
}

.asistente-columna h4 {
  font-size: 0.96rem;
  margin-bottom: 8px;
  color: var(--color-primario);
}

.asistente-lista {
  margin: 0;
  padding-left: 18px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 0.9rem;
  color: var(--color-texto-secundario);
}

.estado-vacio {
  color: var(--color-texto-suave);
  font-size: 0.92rem;
  padding-block: 12px;
}

/* ==========================================================================
   Apartado unificado de preferencias (Objetivo y Dieta)
   ========================================================================== */
.preferencias-panel {
  margin-top: 18px;
  padding: 22px;
  border: 2px solid var(--color-borde);
  border-radius: 20px;
  background: var(--color-superficie);
  box-shadow: 0 6px 18px var(--color-sombra);
}

.preferencias-panel__cabecera {
  margin-bottom: 18px;
}

.preferencias-panel__cabecera .descripcion-seccion {
  margin-top: 5px;
}

.preferencias-panel__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}

.preferencias-subgrupo {
  min-width: 0;
}

.preferencias-subgrupo + .preferencias-subgrupo {
  padding-top: 18px;
  border-top: 1.5px solid var(--color-borde);
}

.preferencias-extra__encabezado {
  margin-bottom: 12px;
}

.titulo-seccion--compacto {
  margin: 0 0 6px;
  font-size: 1.2rem;
}

.objetivos-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.objetivo-opcion {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  width: 100%;
  padding: 15px;
  color: var(--color-texto);
  text-align: left;
  background: var(--color-superficie-alt);
  border: 1.5px solid var(--color-borde);
  border-radius: 16px;
  cursor: pointer;
  transition: transform 160ms ease-out, border-color var(--transicion), background var(--transicion), box-shadow var(--transicion);
}

.objetivo-opcion:hover {
  transform: translateY(-1px);
  border-color: var(--color-primario);
  background: var(--color-primario-suave);
}

.objetivo-opcion[aria-pressed="true"] {
  border-color: var(--color-primario);
  background: var(--color-primario-suave);
  box-shadow: inset 0 0 0 1.5px var(--color-primario);
  animation: objetivo-seleccionado 220ms ease-out both;
}

@keyframes objetivo-seleccionado {
  0% { transform: scale(0.985); }
  65% { transform: scale(1.008); }
  100% { transform: scale(1); }
}

.objetivo-opcion__icono {
  display: grid;
  flex: 0 0 34px;
  width: 34px;
  height: 34px;
  place-items: center;
  color: #ffffff;
  background: var(--color-primario);
  border-radius: 50%;
  font-weight: 700;
}

.objetivo-opcion__texto {
  display: grid;
  gap: 4px;
}

.objetivo-opcion__texto strong {
  font-family: var(--fuente-titulos);
  font-size: 0.95rem;
}

.objetivo-opcion__texto small {
  color: var(--color-texto-secundario);
  line-height: 1.4;
}

.dieta-filtros {
  margin: 0 0 14px;
  padding: 0;
  border: 0;
}

.dieta-filtros__lista {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 10px;
}

.tabla-nutrimental-contenedor {
  overflow-x: auto;
  border: 1.5px solid var(--color-borde-fuerte);
  border-radius: 16px;
  background: var(--color-superficie-alt);
}

.tabla-nutrimental {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.tabla-nutrimental caption {
  padding: 13px 16px;
  color: var(--color-texto);
  text-align: left;
  background: var(--color-primario-suave);
  font-weight: 700;
}

.tabla-nutrimental th,
.tabla-nutrimental td {
  padding: 11px 16px;
  border-top: 1px solid var(--color-borde);
}

.tabla-nutrimental thead th {
  color: var(--color-texto-secundario);
  font-size: 0.82rem;
  font-weight: 700;
}

.tabla-nutrimental tbody th {
  font-weight: 600;
}

.tabla-nutrimental tbody td {
  color: var(--color-primario);
  font-variant-numeric: tabular-nums;
  font-weight: 700;
}

/* ==========================================================================
   Selector de personas en burbujas
   ========================================================================== */
.personas-burbujas {
  display: grid;
  grid-template-columns: repeat(5, minmax(38px, 1fr));
  gap: 8px;
  max-width: 360px;
  padding: 4px 1px;
}

.burbuja-personas {
  display: grid;
  width: 42px;
  height: 42px;
  place-items: center;
  justify-self: center;
  border: 1.5px solid var(--color-borde-fuerte);
  border-radius: 50%;
  background: var(--color-superficie-alt);
  color: var(--color-texto);
  font-weight: 700;
  cursor: pointer;
  transition: transform 180ms ease, background 180ms ease, color 180ms ease, box-shadow 180ms ease;
}

.burbuja-personas:hover {
  transform: translateY(-2px);
  border-color: var(--color-primario);
}

.burbuja-personas.activa {
  transform: scale(1.06);
  border-color: var(--color-primario-hover);
  background: var(--color-primario);
  color: #ffffff;
  box-shadow: 0 5px 14px var(--color-sombra);
}

.personas-ilustracion {
  display: flex;
  min-height: 58px;
  align-items: center;
  gap: 10px;
  margin-top: 6px;
  padding: 8px 12px;
  border: 1.5px solid var(--color-borde);
  border-radius: 16px;
  background: var(--color-superficie-alt);
  color: var(--color-texto);
  font-size: 0.86rem;
  font-weight: 700;
}

.personas-ilustracion__figuras {
  display: flex;
  align-items: center;
  padding-left: 3px;
}

.persona-figura {
  display: inline-grid;
  width: 30px;
  height: 34px;
  place-items: center;
  margin-left: -4px;
  border: 2px solid var(--color-borde);
  border-radius: 50%;
  background: var(--color-superficie);
  font-size: 1.22rem;
  animation: persona-aparece 240ms ease both;
}

.persona-figura:nth-child(2) { animation-delay: 35ms; }
.persona-figura:nth-child(3) { animation-delay: 70ms; }
.persona-figura:nth-child(4) { animation-delay: 105ms; }
.persona-figura:nth-child(5) { animation-delay: 140ms; }

@keyframes persona-aparece {
  from { opacity: 0; transform: scale(0.65) translateY(5px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

/* ==========================================================================
   Modal de receta, Diálogo de Configuración y Notificación
   ========================================================================== */
.modal {
  width: min(560px, calc(100% - 32px));
  border: 2px solid var(--color-borde-fuerte);
  border-radius: var(--radio-grande);
  padding: 0;
  background-color: var(--color-superficie);
  color: var(--color-texto);
  box-shadow: 0 20px 48px var(--color-sombra);
}

.modal::backdrop {
  background-color: rgb(10 18 14 / 52%);
  backdrop-filter: blur(4px);
}

.modal__contenido {
  padding: 22px 24px;
  background-color: var(--color-superficie);
}

.modal__cabecera {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 12px;
  border-bottom: 1.5px solid var(--color-borde);
  margin-bottom: 16px;
}

.modal__titulo {
  font-size: 1.2rem;
}

.boton-cerrar {
  width: 36px;
  height: 36px;
  border: 1.5px solid var(--color-borde-fuerte);
  border-radius: 10px;
  background: var(--color-superficie-alt);
  font-size: 1.35rem;
  line-height: 1;
  color: var(--color-texto);
  cursor: pointer;
}

.boton-cerrar:hover {
  background-color: var(--color-primario);
  color: #ffffff;
}

.modal__cuerpo {
  display: flex;
  flex-direction: column;
  gap: 14px;
  font-size: 0.94rem;
}

.modal__lista {
  margin: 0;
  padding-left: 18px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.boton-configuracion,
.boton-configuracion__cerrar {
  display: grid;
  flex: 0 0 auto;
  width: 40px;
  height: 40px;
  place-items: center;
  border: 1.5px solid var(--color-borde-fuerte);
  border-radius: 50%;
  background: var(--color-superficie-alt);
  color: var(--color-texto);
  font-size: 1.15rem;
  cursor: pointer;
  transition: transform 180ms ease, background 180ms ease, color 180ms ease;
}

.boton-configuracion:hover {
  transform: rotate(24deg);
  background: var(--color-primario);
  color: #ffffff;
}

.config-dialog {
  width: min(370px, calc(100% - 28px));
  max-width: none;
  padding: 0;
  overflow: visible;
  border: 0;
  border-radius: 22px;
  background: transparent;
  color: var(--color-texto);
}

.config-dialog::backdrop {
  background: rgb(10 18 14 / 45%);
  backdrop-filter: blur(4px);
}

.config-dialog__panel {
  padding: 22px;
  border: 2px solid var(--color-borde-fuerte);
  border-radius: 22px;
  background: var(--color-superficie);
  box-shadow: 0 24px 70px var(--color-sombra);
}

.config-dialog__cabecera {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.config-dialog__cabecera h2 {
  font-size: 1.15rem;
}

.boton-configuracion__cerrar {
  width: 34px;
  height: 34px;
  font-size: 1.35rem;
}

.modo-oscuro-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 14px;
  border: 1.5px solid var(--color-borde);
  border-radius: 16px;
  background: var(--color-superficie-alt);
}

.modo-sonidos-control {
  margin-top: 10px;
}

.modo-oscuro-control > span {
  display: grid;
  gap: 3px;
}

.modo-oscuro-control small {
  color: var(--color-texto-secundario);
}

.modo-oscuro-control input[role="switch"] {
  appearance: none;
  position: relative;
  flex: 0 0 auto;
  width: 46px;
  height: 27px;
  margin: 0;
  border: 1px solid var(--color-borde-fuerte);
  border-radius: 999px;
  background: var(--color-seccion);
  cursor: pointer;
  transition: background 180ms ease;
}

.modo-oscuro-control input[role="switch"]::before {
  position: absolute;
  top: 2px;
  left: 2px;
  width: 21px;
  height: 21px;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 1px 4px rgb(0 0 0 / 28%);
  content: "";
  transition: transform 180ms ease;
}

.modo-oscuro-control input[role="switch"]:checked {
  background: var(--color-primario);
  border-color: var(--color-primario-hover);
}

.modo-oscuro-control input[role="switch"]:checked::before {
  transform: translateX(19px);
}

.selector-idioma-label {
  display: block;
  margin: 16px 0 7px;
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--color-texto);
}

.selector-idioma {
  width: 100%;
  min-height: 44px;
  padding: 9px 12px;
  border: 1.5px solid var(--color-borde-fuerte);
  border-radius: 13px;
  background: var(--color-superficie-alt);
  color: var(--color-texto);
  font-weight: 600;
}

.notificacion {
  position: fixed;
  bottom: 88px;
  right: 20px;
  z-index: 80;
  max-width: 360px;
  padding: 12px 16px;
  border: 1.5px solid var(--color-primario);
  border-radius: 12px;
  background-color: var(--color-texto);
  color: #ffffff;
  box-shadow: 0 10px 28px var(--color-sombra);
  font-size: 0.88rem;
  font-weight: 600;
  opacity: 0;
  pointer-events: none;
  transform: translateY(10px);
  transition: opacity var(--transicion), transform var(--transicion);
}

body.modo-oscuro .notificacion {
  background-color: var(--color-superficie-alt);
  color: var(--color-texto);
  border-color: var(--color-primario);
  box-shadow: 0 12px 32px rgb(0 0 0 / 55%);
}

.notificacion.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ==========================================================================
   Pie de página
   ========================================================================== */
.pie-pagina {
  margin-top: 20px;
  border-top: 2px solid var(--color-borde);
  background-color: var(--color-seccion);
  padding-block: 18px;
  font-size: 0.84rem;
  color: var(--color-texto-secundario);
}

.pie-pagina__interior {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

.boton-enlace-peligro {
  background: none;
  border: none;
  padding: 4px 0;
  color: var(--color-peligro);
  font-size: 0.86rem;
  font-weight: 700;
  cursor: pointer;
  text-decoration: underline;
}

/* ==========================================================================
   Animaciones de interacción y scroll
   ========================================================================== */
#btn-generar-header {
  position: relative;
  isolation: isolate;
  overflow: visible;
}

#btn-generar-header.aura-activa {
  animation: pulso-planear 520ms ease-out;
}

#btn-generar-header.aura-activa::after {
  content: "";
  position: absolute;
  z-index: -1;
  inset: -4px;
  border: 2px solid color-mix(in srgb, var(--color-primario) 65%, white);
  border-radius: inherit;
  pointer-events: none;
  animation: aura-expansiva 520ms ease-out both;
}

@keyframes aura-expansiva {
  0% { opacity: 0.6; transform: scale(0.98); }
  100% { opacity: 0; transform: scale(1.22); }
}

@keyframes pulso-planear {
  0%, 100% { transform: translateY(0) scale(1); }
  35% { transform: translateY(-1px) scale(1.02); }
}

@supports (animation-timeline: scroll()) {
  .panel-resumen {
    animation: compactar-presupuesto linear both;
