function generarMenuSemanal(modoEconomico = false) {
  const perfil = estado.perfil;
  const objetivo = (() => {
    try {
      return JSON.parse(
        localStorage.getItem("planeadorPreferenciasAlimentacion") || "{}"
      ).objetivo || "";
    } catch {
      return "";
    }
  })();

  const tiempos = ["desayuno", "comida", "cena"];

  const candidatasPorTiempo = Object.fromEntries(
    tiempos.map((tiempo) => {
      let candidatas = RECETAS_BASE.filter(
        (receta) =>
          receta.tiempo === tiempo &&
          recetaEsCompatible(receta, perfil)
      );

      // Si las restricciones no dejan opciones, conserva el respaldo existente.
      if (!candidatas.length) {
        candidatas = RECETAS_BASE.filter(
          (receta) => receta.tiempo === tiempo
        );
      }

      return [
        tiempo,
        candidatas.map((receta) => ({
          receta,
          costo: calcularCostoReceta(receta)
        }))
      ];
    })
  );

  // Cada desayuno, comida y cena es un espacio del presupuesto semanal.
  const espacios = DIAS_SEMANA.flatMap((dia) =>
    tiempos.map((tiempo) => ({ dia, tiempo }))
  );

  // Calcula cuánto costaría, como mínimo, completar los espacios restantes.
  const costoMinimoRestante = Array(espacios.length + 1).fill(0);

  for (let i = espacios.length - 1; i >= 0; i--) {
    const opciones = candidatasPorTiempo[espacios[i].tiempo];
    const costoMinimo = Math.min(...opciones.map((opcion) => opcion.costo));

    costoMinimoRestante[i] =
      costoMinimoRestante[i + 1] + costoMinimo;
  }

  const presupuesto = Math.max(0, Number(perfil.presupuesto) || 0);
  const cabeEnPresupuesto = costoMinimoRestante[0] <= presupuesto;
  let restante = presupuesto;
  const seleccion = [];

  espacios.forEach((espacio, indice) => {
    const opciones = candidatasPorTiempo[espacio.tiempo];

    // Reserva lo necesario para las comidas que faltan.
    const maximoParaEstaComida = cabeEnPresupuesto
      ? Math.max(0, restante - costoMinimoRestante[indice + 1])
      : Infinity;

    let disponibles = opciones.filter(
      (opcion) => opcion.costo <= maximoParaEstaComida + 0.001
    );

    // Si es imposible cumplir el presupuesto, considera todas y elegirá la más barata.
    if (!disponibles.length) disponibles = opciones;

    const ahorroActivo = modoEconomico || objetivo === "ahorro";

    const opcionesConPuntaje = disponibles.map((opcion) => ({
      ...opcion,
      utilidad:
        puntuarReceta(opcion.receta, perfil) * 10 -
        (opcion.costo / Math.max(1, presupuesto)) * 5
    }));

    opcionesConPuntaje.sort((a, b) =>
      ahorroActivo
        ? a.costo - b.costo
        : b.utilidad - a.utilidad || a.costo - b.costo
    );

    const elegida = opcionesConPuntaje[0];

    seleccion.push({
      dia: espacio.dia,
      tiempo: espacio.tiempo,
      id: elegida.receta.id,
      costo: elegida.costo
    });

    restante -= elegida.costo;
  });

  estado.menuSemanal = DIAS_SEMANA.map((dia) => {
    const comidasDelDia = seleccion.filter((item) => item.dia === dia);

    return {
      dia,
      desayuno: comidasDelDia.find((item) => item.tiempo === "desayuno").id,
      comida: comidasDelDia.find((item) => item.tiempo === "comida").id,
      cena: comidasDelDia.find((item) => item.tiempo === "cena").id
    };
  });

  guardarEstado();
}
